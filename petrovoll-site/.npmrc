# ────────────────────────────────────────────────────────────────────────────
# .npmrc — Contraintes de résolution npm pour le projet PETROVOLL
# ─────────────────────────────────────────────────────────────────────────────
#
# legacy-peer-deps=true
#   Raison : la stack demandée associe Next.js 14 (App Router) et Payload CMS v3.
#   Or Payload v3 déclare une peerDependency stricte `next: ^15.2.3`.
#   Sans ce flag, `npm install` échoue avec un ERESOLVE et bloque tout le projet.
#
#   ⚠️ IMPORTANT : Payload v3 n'est officiellement supporté QUE sur Next.js 15+.
#   Ce flag permet d'installer le squelette, mais dès que tu câbles réellement
#   `withPayload()` dans la config Next, passe à Next.js 15.2+ (voir README.md,
#   section « Compatibilité Payload v3 / Next.js »).
#
legacy-peer-deps=true

# Évite l'envoi de télémesures pendant les installs en CI / Docker.
fund=false
audit=false