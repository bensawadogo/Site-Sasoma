// ─────────────────────────────────────────────────────────────────────────────
//  Prisma — Schéma de la base PostgreSQL PETROVOLL
// ─────────────────────────────────────────────────────────────────────────────
//
//  ⚠️  CHOIX D'ARCHITECTURE À VALIDER (TODO [db] n°1) — À LIRE AVANT DE MIGRER
//
//  Deux systèmes veulent piloter le MÊME PostgreSQL :
//    • Payload CMS v3 (@payloadcms/db-postgres) → possède ses propres tables
//      et SA propre table de migrations (`payload_migrations`).
//    • Prisma → possède ses propres migrations (`_prisma_migrations`).
//
//  Écrire dans le même schéma PostgreSQL = conflits garantis.
//
//  Stratégie recommandée :
//    • schema `payload` → 100 % des collections éditoriales (produits,
//      secteurs, catégories, médias, users admin) gérées par Payload
//      via `npm run payload migrate:*`.
//    • schema `app`     → uniquement les tables « applicatives » de CE fichier
//      (leads, devis, newsletter), gérées par `npm run prisma:migrate`.
//
//  → Déclarer `schemaName` dans l'adaptateur Payload, et utiliser
//    `?schema=app` dans DATABASE_URL côté Prisma (.env.local.example).
//
//  TODO [db] n°2 : si l'équipe veut une source de vérité unique :
//    (A) Payload seul + Payload Local API partout  ← recommandé, moins de code
//    (B) Prisma seul + collections Payload désactivées
//  Le schéma ci-dessous supporte les deux (doublon volontaire et documenté).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════════════════
//  AUTHENTIFICATION / ADMIN
//  (miroir optionnel de la collection Payload `Users` — voir stratégie ci-dessus)
// ════════════════════════════════════════════════════════════════════════════

enum Role {
  SUPER_ADMIN
  EDITEUR
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  // TODO [auth] : hash bcryptjs (12 rounds) — jamais de mot de passe en clair.
  passwordHash      String?
  role              Role      @default(EDITEUR)
  actif             Boolean   @default(true)
  derniereConnexion DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("users")
}

// ════════════════════════════════════════════════════════════════════════════
//  CATALOGUE (les 5 secteurs d'activité + arborescence produits)
// ════════════════════════════════════════════════════════════════════════════

model Secteur {
  id           String    @id @default(cuid())
  nom          String
  slug         String    @unique
  // Nom d'icône Lucide, ex. "Droplet", "Truck", "Globe"
  icone        String?
  // Couleur hexadécimale, ex. "#D4420A"
  couleur      String?
  ordre        Int       @default(0)
  // true pour « Huile moteur & lubrifiants » (secteur principal / PETROVOLL)
  estPrincipal Boolean   @default(false)
  description  Json?
  produits     Produit[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("secteurs")
}

model Categorie {
  id          String      @id @default(cuid())
  nom         String
  slug        String      @unique
  secteurId   String?
  secteur     Secteur?    @relation(fields: [secteurId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Categorie?  @relation("CategorieEnfant", fields: [parentId], references: [id], onDelete: SetNull)
  enfants     Categorie[] @relation("CategorieEnfant")
  produits    Produit[]
  description Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("categories")
}

model Produit {
  id              String     @id @default(cuid())
  nom             String
  slug            String     @unique
  secteurId       String?
  secteur         Secteur?   @relation(fields: [secteurId], references: [id], onDelete: SetNull)
  categorieId     String?
  categorie       Categorie? @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  description     Json?
  // true → mise en vedette sur la Home (section produit phare PETROVOLL)
  estProduitPhare Boolean    @default(false)
  // Marque commerciale, ex. "PETROVOLL"
  marque          String?
  // Référence commerciale, ex. "PTV-15W40-5L"
  reference       String?
  disponible      Boolean    @default(true)
  // Date d'ajout automatique (cf. champ `dateAjout` de la collection Payload)
  dateAjout       DateTime   @default(now())
  ordre           Int        @default(0)
  images          Media[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // TODO [catalogue] : ajouter `poids`, `volume`, `conditionnement` (bidon 1L/5L/20L)
  // et `indiceViscosite` (15W-40, 20W-50…) si le client veut filtrer finement.
  @@index([estProduitPhare])
  @@index([secteurId])
  @@map("produits")
}

model Media {
  id        String    @id @default(cuid())
  alt       String
  url       String
  // Identifiant Cloudinary (transformations / suppression)
  publicId  String?   @unique
  largeur   Int?
  hauteur   Int?
  format    String?
  taille    Int?
  produitId String?
  produit   Produit?  @relation(fields: [produitId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("medias")
}

// ════════════════════════════════════════════════════════════════════════════
//  LEADS / CONTACT (tables réellement « applicatives » côté Prisma)
// ════════════════════════════════════════════════════════════════════════════

enum StatutLead {
  NOUVEAU
  EN_COURS
  DEVIS_ENVOYE
  CONVERTI
  PERDU
}

model DemandeDevis {
  id               String     @id @default(cuid())
  nom              String
  entreprise       String?
  email            String
  telephone        String
  pays             String?
  secteurConcerne  String?
  quantiteEstimee  String?
  message          String
  statut           StatutLead @default(NOUVEAU)
  consentementRgpd Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // TODO [rgpd] : prévoir l'anonymisation à la demande (droit à l'effacement)
  @@index([statut])
  @@map("demandes_devis")
}

model NewsletterAbonne {
  id        String   @id @default(cuid())
  email     String   @unique
  actif     Boolean  @default(true)
  // Jeton de confirmation / désinscription (double opt-in)
  jeton     String?  @unique
  createdAt DateTime @default(now())

  @@map("newsletter_abonnes")
}

