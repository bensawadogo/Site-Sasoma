# ── Contexte de build Docker (tout ce qui n'est PAS nécessaire au build) ────
node_modules
.next
.git
.gitignore
Dockerfile
docker-compose.yml
.dockerignore

# ── Secrets : jamais copiés dans l'image ───────────────────────────────────
.env
.env.*
!.env.local.example

