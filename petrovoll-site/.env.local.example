# ════════════════════════════════════════════════════════════════════════════
#  PETROVOLL — Variables d'environnement (MODÈLE)
#  Copier ce fichier :  cp .env.local.example .env.local
#  ⚠️  .env.local ne doit JAMAIS être commité (voir .gitignore).
#  ⚠️  Générer les secrets avec : openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_NAME="PETROVOLL"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"
# Utilisé par Payload pour les URLs absolues (admin, emails, uploads)

# ─── Base de données — PostgreSQL ───────────────────────────────────────────
# DATABASE_URL = consommée par Prisma
# DATABASE_URI = consommée par l'adaptateur Payload (@payloadcms/db-postgres)
# → même valeur pour les deux dans ce projet (une seule base, deux accès).
DATABASE_URL="postgresql://petrovoll:petrovoll@localhost:5432/petrovoll?schema=public"
DATABASE_URI="postgresql://petrovoll:petrovoll@localhost:5432/petrovoll"
# Utilisée uniquement par le service `db` de docker-compose.yml
POSTGRES_USER=petrovoll
POSTGRES_PASSWORD=petrovoll
POSTGRES_DB=petrovoll
POSTGRES_PORT=5432

# ─── Payload CMS v3 ─────────────────────────────────────────────────────────
# Secret de signature des JWT admin / cookies Payload (openssl rand -base64 32)
PAYLOAD_SECRET="CHANGE_ME_PAYLOAD_SECRET_32_CHARS_MIN"
# Domaine autorisé pour l'admin Payload en production (CSRF)
PAYLOAD_PUBLIC_SERVER_URL="http://localhost:3000"
# Champs preview / drafts (utilisé plus tard par le live preview de Payload)
PAYLOAD_PREVIEW_SECRET="CHANGE_ME_PREVIEW_SECRET"

# ─── NextAuth.js v5 ─────────────────────────────────────────────────────────
AUTH_SECRET="CHANGE_ME_AUTH_SECRET_32_CHARS_MIN"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# ─── Seed admin initial (script prisma/seed.ts — à créer) ───────────────────
SEED_ADMIN_EMAIL="admin@petrovoll.example"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# ─── Cloudinary (stockage images produits / médias) ─────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="petrovoll"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ─── Contact / demandes de devis B2B ────────────────────────────────────────
CONTACT_EMAIL_TO="commercial@petrovoll.example"
CONTACT_EMAIL_FROM="no-reply@petrovoll.example"
# TODO [contact] : renseigner le vrai numéro commercial (format international)
NEXT_PUBLIC_WHATSAPP_NUMBER="+2250000000000"

# ─── SMTP (envoi des demandes de devis / formulaires) ───────────────────────
# TODO [email] : brancher un provider (Resend, Brevo, Mailgun…) côté route handler
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ─── 3D — Scène du bidon PETROVOLL ──────────────────────────────────────────
# Place le fichier .glb dans public/models/ puis garde ce chemin.
NEXT_PUBLIC_BIDON_MODEL_PATH="/models/petrovoll-bidon.glb"
# Passer à "true" pour afficher le fallback 2D (utile si WebGL indisponible / mobile bas de gamme)
NEXT_PUBLIC_DISABLE_3D="false"

# ─── Revalidation / cache ISR ───────────────────────────────────────────────
# Secret partagé pour déclencher /api/revalidate depuis les webhooks Payload
REVALIDATE_SECRET="CHANGE_ME_REVALIDATE_SECRET"

# ─── Analytics (optionnel) ──────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""