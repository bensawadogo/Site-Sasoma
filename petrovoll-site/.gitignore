.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Payload CMS ──────────────────────────────────────────────────────────────
/payload/admin/importMap.js
# Types générés : à régénérer via `npm run payload:generate-types`
# (décommenter la ligne suivante si vous ne versionnez pas les types générés)
# /types/payload-types.ts

# ── Prisma ───────────────────────────────────────────────────────────────────
# Les migrations DOIVENT être versionnées (ne pas décommenter).
# /prisma/migrations

# ── Uploads / médias ─────────────────────────────────────────────────────────
# En développement, Payload écrit dans public/media → on ignore le contenu mais
# on conserve le dossier (Payload ne crée pas l'arborescence tout seul).
/public/media/*
!/public/media/.gitkeep
# Les fichiers binaires lourds ne sont pas versionnés (Cloudinary en production)
/public/models/*.glb
/public/models/*.gltf
/public/videos/*.mp4
/public/videos/*.webm
/public/images/uploads/*

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# ── Éditeurs / OS ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.swp