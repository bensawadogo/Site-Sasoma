# En-têtes HTTP appliqués par Cloudflare Pages.
# Pas de Content-Security-Policy stricte pour l'instant : l'admin Keystatic et
# les scripts inline d'Astro demanderaient une liste fine à maintenir ; à
# ajouter une fois les domaines tiers définitifs connus.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fichiers au nom haché par Astro : ils ne changent jamais, cache 1 an.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Modèles 3D et image du bidon : dans /_astro/ (nom haché), donc déjà couverts
# ci-dessus. Décodeurs Draco : nom fixe, cache 30 jours.
/draco/*
  Cache-Control: public, max-age=2592000

# Polices et logo : noms fixes, rarement modifiés. Cache 30 jours (sans
# revalidation à chaque page, un aller-retour de moins en 3G).
/fonts/*
  Cache-Control: public, max-age=2592000

/images/*
  Cache-Control: public, max-age=2592000

# Séquences du hero vidéo : noms fixes, version dans l'adresse (?v=), cache 30 jours.
/hero-video/*
  Cache-Control: public, max-age=2592000

# Service worker : jamais en cache, pour que chaque nouvelle version soit vue
# immédiatement. Il est à la racine, donc sa portée est tout le site
# (pas besoin de Service-Worker-Allowed).
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Manifest PWA : peut changer (nom, icônes), cache court.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

# Icônes et visuels de partage : noms fixes, cache 30 jours.
/icon-*.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000

# Pages HTML : Cloudflare Pages les sert déjà avec max-age=0, must-revalidate
# (ETag, 304 sans corps) : rien à ajouter, le contenu reste frais après chaque publication.
