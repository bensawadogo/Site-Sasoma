# ════════════════════════════════════════════════════════════════════════════
#  PETROVOLL — Variables d'environnement (MODÈLE)
#  Copier : cp .env.example .env      ⚠️ .env ne doit JAMAIS être commité.
#
#  Convention Astro : seules les variables préfixées PUBLIC_ sont exposées au
#  navigateur (import.meta.env.PUBLIC_*). Tout le reste reste côté serveur.
# ════════════════════════════════════════════════════════════════════════════

# ─── Site ───────────────────────────────────────────────────────────────────
# L'URL canonique de production se configure dans astro.config.mjs (`site`) :
# elle alimente import.meta.env.SITE, le sitemap, les canonical et og:url.
# PUBLIC_SITE_URL n'est utile que si vous préférez la piloter par l'environnement.
PUBLIC_SITE_URL="https://petrovoll.example"

# ─── Contact commercial (utilisé par les CTA) ───────────────────────────────
# Format international SANS « + » ni espaces (requis par https://wa.me/…)
PUBLIC_WHATSAPP_NUMBER="2250000000000"
PUBLIC_CONTACT_EMAIL="commercial@petrovoll.example"
PUBLIC_CONTACT_TELEPHONE="+225 00 00 00 00"

# ─── Cloudinary (images produits hébergées) ─────────────────────────────────
# Valeurs serveur : uploads / transformations signées (NE PAS préfixer PUBLIC_)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Côté client : uniquement le nom du cloud (les transformations publiques)
PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── Keystatic — mode GitHub (édition depuis le navigateur en production) ───
# Requis UNIQUEMENT si `storage.kind === 'github'` dans keystatic.config.ts.
# Créer une GitHub App : https://keystatic.com/docs/github-mode
# ⚠️ Ces 3 valeurs sont strictement serveur.
KEYSTATIC_GITHUB_CLIENT_ID=""
KEYSTATIC_GITHUB_CLIENT_SECRET=""
KEYSTATIC_SECRET=""

# ─── Analytics (optionnel) ──────────────────────────────────────────────────
PUBLIC_UMAMI_WEBSITE_ID=""
PUBLIC_GA_MEASUREMENT_ID=""

# ─── Cloudflare (déploiement) ───────────────────────────────────────────────
# Utilisé par wrangler lors du `npm run deploy` (ou via `wrangler login`)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
