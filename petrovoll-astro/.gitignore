# ── Dépendances / build ─────────────────────────────────────────────────────
node_modules/
dist/
.astro/
.vercel/
.wrangler/

# ── Variables d'environnement (JAMAIS commitées) ────────────────────────────
.env
.env.local
.env.*.local
.dev.vars

# ── Médias lourds ────────────────────────────────────────────────────────────
# Les modèles du bidon vivent dans src/assets/bidon/ (commités, nom haché au build).
# Le scan brut assets-source/bidon-meshy.glb (33 Mo) reste LOCAL : Cloudflare Pages
# refuse les fichiers > 25 Mo.
assets-source/*.glb
assets-source/*.bak
public/models/*.gltf
public/models/*.hdr
public/videos/*.mp4
# Les images produits passent par Cloudinary ou src/assets (optimisées au build)
public/images/uploads/*

# ── Artefacts QA (screenshots mobiles, captures de test) ────────────────────
qa-screenshots/

# ── Logs / divers ───────────────────────────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.vercel
.env*
