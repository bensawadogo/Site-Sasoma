---
/**
 * Contact — coordonnées (admin → Coordonnées) + formulaire de devis.
 *
 * Le formulaire est envoyé par e-mail via Web3Forms (gratuit, sans serveur) :
 * la clé PUBLIC_WEB3FORMS_KEY est liée à l'adresse de réception choisie à sa
 * création sur web3forms.com. Cette clé est publique par conception (elle ne
 * permet que d'envoyer vers CETTE adresse). Sans clé, le formulaire est masqué
 * et seuls WhatsApp / téléphone / e-mail sont proposés.
 *
 * Anti-spam : champ piège « botcheck » invisible (les robots le remplissent).
 */
import PageLayout from '@/layouts/PageLayout.astro'
import { getParametres } from '@/lib/contenu'

export const prerender = true

const parametres = await getParametres()
const cleWeb3Forms = import.meta.env.PUBLIC_WEB3FORMS_KEY
const lienWhatsApp = parametres.whatsapp()
const aucunCanal = !lienWhatsApp && !parametres.lienTelephone && !parametres.email && !cleWeb3Forms
const canaux = [lienWhatsApp && 'par WhatsApp', parametres.lienTelephone && 'par téléphone', parametres.email && 'par e-mail']
  .filter(Boolean)
  .join(' ou ')
if (aucunCanal) {
  console.warn('[contact] aucun canal de contact : renseigner téléphone, WhatsApp ou e-mail dans l’admin (Coordonnées).')
}

const schema: Array<Record<string, unknown>> = [
  {
    '@type': 'ContactPage',
    mainEntity: {
      '@type': 'ContactPoint',
      contactType: 'sales',
      areaServed: 'Afrique de l’Ouest',
      availableLanguage: 'French',
      ...(parametres.telephone ? { telephone: parametres.telephone } : {}),
      ...(parametres.email ? { email: parametres.email } : {}),
    },
  },
]
---

<PageLayout
  titre="Contact & devis"
  description="Demandez un devis : lubrifiants Petrovöll, transport, pneumatiques, fournitures. Réponse rapide par téléphone, WhatsApp ou e-mail."
  canonicalChemin="/contact"
  schema={schema}
>
  <div class="container-page grid grid-cols-1 gap-10 py-10 lg:grid-cols-2 lg:py-14">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-vif">Contact</p>
      <h1 class="mt-2 text-3xl sm:text-4xl lg:text-5xl">Demander un devis</h1>
      <span class="section-line" aria-hidden="true" />

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        {
          lienWhatsApp && (
            <a href={lienWhatsApp} target="_blank" rel="noopener noreferrer" class="btn-primary w-full sm:w-auto">
              Écrire sur WhatsApp
            </a>
          )
        }
        {
          parametres.lienTelephone && (
            <a href={parametres.lienTelephone} class="btn-outline w-full sm:w-auto">
              Appeler {parametres.telephone}
            </a>
          )
        }
      </div>

      <dl class="mt-8 space-y-4 text-base">
        {parametres.email && (
          <div>
            <dt class="text-xs uppercase tracking-wide text-attenue">E-mail</dt>
            <dd><a href={`mailto:${parametres.email}`} class="break-all text-vif underline underline-offset-4">{parametres.email}</a></dd>
          </div>
        )}
        {parametres.adresse && (
          <div>
            <dt class="text-xs uppercase tracking-wide text-attenue">Adresse</dt>
            <dd class="whitespace-pre-line">{parametres.adresse}</dd>
          </div>
        )}
        {parametres.horaires && (
          <div>
            <dt class="text-xs uppercase tracking-wide text-attenue">Horaires</dt>
            <dd class="whitespace-pre-line">{parametres.horaires}</dd>
          </div>
        )}
      </dl>
    </div>

    {
      cleWeb3Forms ? (
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="grid grid-cols-1 gap-4 rounded-md border border-bordure bg-surface p-5 sm:p-6"
          data-formulaire-contact
        >
          <input type="hidden" name="access_key" value={cleWeb3Forms} />
          <input type="hidden" name="subject" value={`Nouvelle demande depuis le site ${parametres.nomSociete}`} />
          <input type="hidden" name="from_name" value={`Site ${parametres.nomSociete}`} />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <label class="flex flex-col gap-1 text-sm">
            Votre nom ou société *
            <input required name="nom" autocomplete="name" maxlength="120" class="champ" />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            Téléphone / WhatsApp *
            <input required type="tel" name="telephone" autocomplete="tel" inputmode="tel" maxlength="30" class="champ" placeholder="+226 …" />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            E-mail (facultatif)
            <input type="email" name="email" autocomplete="email" maxlength="120" class="champ" />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            Produit concerné (facultatif)
            <input name="produit" maxlength="160" class="champ" data-champ-produit />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            Votre message *
            <textarea required name="message" rows="5" maxlength="3000" class="champ py-3" placeholder="Besoin, quantités, ville de livraison…" />
          </label>

          <button type="submit" class="btn-primary w-full" data-bouton-envoi data-whatsapp={lienWhatsApp ? '' : undefined}>Envoyer la demande</button>
          <p class="text-sm" role="status" aria-live="polite" data-message-envoi hidden />
        </form>
      ) : aucunCanal ? (
        <p class="rounded-md border border-dashed border-bordure p-6 text-base text-attenue">
          {parametres.nomSociete} : nos coordonnées seront bientôt disponibles sur cette page.
        </p>
      ) : (
        <p class="rounded-md border border-dashed border-bordure p-6 text-base text-attenue">
          Contactez-nous directement {canaux} : nous vous répondons rapidement.
        </p>
      )
    }
  </div>
</PageLayout>

<style>
  .champ {
    min-height: 48px;
    border-radius: 0.25rem;
    border: 1px solid var(--color-bordure);
    background: var(--color-fond);
    padding: 0 0.75rem;
    font-size: 1rem; /* ≥ 16 px : évite le zoom automatique d'iOS au focus */
  }
</style>

<script>
  const formulaire = document.querySelector<HTMLFormElement>('[data-formulaire-contact]')

  if (formulaire) {
    // Pré-remplissage depuis une fiche produit (/contact?produit=…).
    const produit = new URLSearchParams(location.search).get('produit')
    const champProduit = formulaire.querySelector<HTMLInputElement>('[data-champ-produit]')
    if (produit && champProduit) champProduit.value = produit.slice(0, 160)

    const bouton = formulaire.querySelector<HTMLButtonElement>('[data-bouton-envoi]')!
    const message = formulaire.querySelector<HTMLElement>('[data-message-envoi]')!

    const afficher = (texte: string, succes: boolean) => {
      message.hidden = false
      message.textContent = texte
      message.className = `text-sm ${succes ? 'text-succes' : 'text-vif'}`
    }

    formulaire.addEventListener('submit', async (evenement) => {
      evenement.preventDefault()
      bouton.disabled = true
      bouton.textContent = 'Envoi en cours…'
      try {
        const reponse = await fetch(formulaire.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(formulaire),
        })
        const resultat = (await reponse.json().catch(() => ({}))) as { success?: boolean }
        if (!reponse.ok || !resultat.success) throw new Error(`HTTP ${reponse.status}`)
        formulaire.reset()
        afficher('Merci ! Votre demande est bien envoyée, nous vous recontactons rapidement.', true)
      } catch (erreur) {
        console.warn('[contact] envoi échoué', erreur)
        // Ne proposer WhatsApp que si un numéro est saisi dans l'admin.
        const repli = bouton.hasAttribute('data-whatsapp') ? ', ou écrivez-nous directement sur WhatsApp' : ''
        afficher(`L’envoi n’a pas abouti (connexion instable ?). Réessayez${repli}.`, false)
      } finally {
        bouton.disabled = false
        bouton.textContent = 'Envoyer la demande'
      }
    })
  }
</script>
