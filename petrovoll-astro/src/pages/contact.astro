---
/**
 * Contact — coordonnées (admin → Coordonnées) + formulaire de devis + carte.
 *
 * Le formulaire est TOUJOURS affiché (#devis : cible des boutons « Devis »), la carte à côté.
 * Envoi par e-mail via Web3Forms (gratuit, sans serveur) : la clé PUBLIC_WEB3FORMS_KEY est
 * liée à l'adresse de réception choisie à sa création sur web3forms.com. Cette clé est
 * publique par conception (elle ne permet que d'envoyer vers CETTE adresse). Sans clé, la
 * demande part par WhatsApp (message prérempli) ou, à défaut, par e-mail.
 *
 * Anti-spam : champ piège « botcheck » invisible (les robots le remplissent).
 */
import PageLayout from '@/layouts/PageLayout.astro'
import { getParametres } from '@/lib/contenu'

export const prerender = true

const parametres = await getParametres()
const cleWeb3Forms = import.meta.env.PUBLIC_WEB3FORMS_KEY
const lienWhatsApp = parametres.whatsapp()
const aucunCanal = !lienWhatsApp && !parametres.lienTelephone && !parametres.email && !cleWeb3Forms
if (aucunCanal) {
  console.warn('[contact] aucun canal de contact : renseigner téléphone, WhatsApp ou e-mail dans l’admin (Coordonnées).')
}

// Carte (Ben, 09/10) : centrée sur l'adresse de l'admin ; tant qu'elle est vide, sur Ouagadougou.
const lieu = parametres.adresse?.replace(/\s+/g, ' ').trim() || 'Ouagadougou, Burkina Faso'
const carteSrc = `https://maps.google.com/maps?q=${encodeURIComponent(lieu)}&z=${parametres.adresse ? 15 : 12}&hl=fr&output=embed`
const itineraire = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(lieu)}`

const schema: Array<Record<string, unknown>> = [
  {
    '@type': 'ContactPage',
    mainEntity: {
      '@type': 'ContactPoint',
      contactType: 'sales',
      areaServed: 'Afrique de l’Ouest',
      availableLanguage: 'French',
      ...(parametres.telephone ? { telephone: parametres.telephone } : {}),
      ...(parametres.email ? { email: parametres.email } : {}),
    },
  },
]
---

<PageLayout
  titre="Contact & devis"
  description="Demandez un devis : lubrifiants Petrovöll, transport, pneumatiques, fournitures. Réponse rapide par téléphone, WhatsApp ou e-mail."
  canonicalChemin="/contact"
  schema={schema}
>
  <div class="container-page py-8 lg:py-12">
    <header class="flex flex-col gap-3">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-vif">Contact · Devis gratuit</p>
      <h1 class="text-4xl text-marine sm:text-5xl lg:text-6xl">Demander un devis</h1>
      <p class="max-w-2xl text-base leading-relaxed text-attenue">
        Dites-nous ce qu’il vous faut (produit, quantité, ville de livraison) : nous vous répondons rapidement.
      </p>
      {
        (lienWhatsApp || parametres.lienTelephone) && (
          <div class="mt-2 flex flex-col gap-3 sm:flex-row">
            {lienWhatsApp && (
              <a href={lienWhatsApp} target="_blank" rel="noopener noreferrer" class="btn-primary w-full sm:w-auto">
                Écrire sur WhatsApp
              </a>
            )}
            {parametres.lienTelephone && (
              <a href={parametres.lienTelephone} class="btn-outline w-full sm:w-auto">
                Appeler {parametres.telephone}
              </a>
            )}
          </div>
        )
      }
    </header>

    <!-- Formulaire (toujours affiché : le bouton « Devis » mène ici) et carte, côte à côte sur ordinateur. -->
    <div class="mt-8 grid grid-cols-1 gap-6 lg:mt-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-8">
      <form
        id="devis"
        action={cleWeb3Forms ? 'https://api.web3forms.com/submit' : '#devis'}
        method="POST"
        class="formulaire-devis"
        data-formulaire-contact
        data-web3forms={cleWeb3Forms ? '' : undefined}
        data-whatsapp={lienWhatsApp ?? undefined}
        data-email={parametres.email || undefined}
      >
        {cleWeb3Forms && <input type="hidden" name="access_key" value={cleWeb3Forms} />}
        <input type="hidden" name="subject" value={`Nouvelle demande depuis le site ${parametres.nomSociete}`} />
        <input type="hidden" name="from_name" value={`Site ${parametres.nomSociete}`} />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <h2 class="text-3xl text-marine">Votre demande</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1 text-sm font-medium">
            Nom ou société *
            <input required name="nom" autocomplete="name" maxlength="120" class="champ" />
          </label>
          <label class="flex flex-col gap-1 text-sm font-medium">
            Téléphone / WhatsApp *
            <input required type="tel" name="telephone" autocomplete="tel" inputmode="tel" maxlength="30" class="champ" placeholder="+226 …" />
          </label>
        </div>
        <label class="flex flex-col gap-1 text-sm font-medium">
          E-mail (facultatif)
          <input type="email" name="email" autocomplete="email" maxlength="120" class="champ" />
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium">
          Besoin
          <select name="besoin" class="champ">
            <option>Lubrifiants Petrovöll</option>
            <option>Transport & logistique</option>
            <option>Distribution & import-export</option>
            <option>Pneumatiques</option>
            <option>Fournitures de bureau</option>
            <option>Autre</option>
          </select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium">
          Produit concerné (facultatif)
          <input name="produit" maxlength="160" class="champ" data-champ-produit />
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium">
          Votre message *
          <textarea required name="message" rows="4" maxlength="3000" class="champ py-3" placeholder="Quantités, ville de livraison…"></textarea>
        </label>
        <button type="submit" class="btn-primary w-full" data-bouton-envoi>Envoyer la demande</button>
        <p class="text-sm" role="status" aria-live="polite" data-message-envoi hidden></p>
      </form>

      <section class="carte-cadre" aria-labelledby="titre-carte">
        <iframe
          src={carteSrc}
          title={`Carte : ${lieu}`}
          loading="eager"
          referrerpolicy="no-referrer-when-downgrade"
          class="absolute inset-0 h-full w-full border-0"
        ></iframe>
        <div class="carte-fiche">
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-vif">Nous trouver</p>
          <h2 id="titre-carte" class="mt-1 text-3xl text-marine">{parametres.nomSociete}</h2>
          <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-texte">{parametres.adresse || 'Ouagadougou, Burkina Faso'}</p>
          {parametres.horaires && <p class="mt-2 whitespace-pre-line text-sm text-attenue">{parametres.horaires}</p>}
          {
            parametres.email && (
              <p class="mt-2 text-sm">
                <a href={`mailto:${parametres.email}`} class="text-vif underline underline-offset-4">
                  {parametres.email}
                </a>
              </p>
            )
          }
          <a href={itineraire} target="_blank" rel="noopener noreferrer" class="btn-primary mt-4 w-full">Itinéraire</a>
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .formulaire-devis {
    display: grid;
    gap: 1rem;
    align-content: start;
    border: 1px solid #dce4ee;
    border-radius: 1.25rem;
    background: #fff;
    padding: 1.5rem;
    box-shadow: 0 30px 60px -35px rgb(11 27 51 / 0.35);
    scroll-margin-top: 6rem;
  }
  @media (min-width: 640px) {
    .formulaire-devis {
      padding: 2rem;
    }
  }
  .carte-cadre {
    position: relative;
    overflow: hidden;
    min-height: 420px;
    border: 1px solid #dce4ee;
    border-radius: 1.25rem;
    background: #e6edf4;
    box-shadow: 0 30px 60px -35px rgb(11 27 51 / 0.35);
  }
  .carte-fiche {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.92);
    padding: 1.25rem;
    box-shadow: 0 20px 40px -20px rgb(11 27 51 / 0.45);
    backdrop-filter: blur(10px);
  }
  @media (min-width: 1024px) {
    .carte-cadre {
      min-height: 100%;
    }
    .carte-fiche {
      right: auto;
      width: 320px;
    }
  }
</style>

<script>
  const formulaire = document.querySelector<HTMLFormElement>('[data-formulaire-contact]')

  if (formulaire) {
    // Pré-remplissage depuis une fiche produit (/contact?produit=…).
    const produit = new URLSearchParams(location.search).get('produit')
    const champProduit = formulaire.querySelector<HTMLInputElement>('[data-champ-produit]')
    if (produit && champProduit) champProduit.value = produit.slice(0, 160)

    const bouton = formulaire.querySelector<HTMLButtonElement>('[data-bouton-envoi]')!
    const message = formulaire.querySelector<HTMLElement>('[data-message-envoi]')!
    const afficher = (texte: string, succes: boolean) => {
      message.hidden = false
      message.textContent = texte
      message.className = `text-sm ${succes ? 'text-succes' : 'text-vif'}`
    }
    /** La demande en texte (WhatsApp ou e-mail, quand Web3Forms n'est pas configuré). */
    const texteDemande = () => {
      const d = new FormData(formulaire)
      return [
        'Bonjour, je souhaite un devis.',
        `Nom : ${d.get('nom')}`,
        `Téléphone : ${d.get('telephone')}`,
        d.get('email') && `E-mail : ${d.get('email')}`,
        `Besoin : ${d.get('besoin')}`,
        d.get('produit') && `Produit : ${d.get('produit')}`,
        `Message : ${d.get('message')}`,
      ]
        .filter(Boolean)
        .join('\n')
    }

    formulaire.addEventListener('submit', async (evenement) => {
      evenement.preventDefault()
      // Sans Web3Forms : la demande part par WhatsApp (message prérempli), sinon par e-mail.
      if (!formulaire.hasAttribute('data-web3forms')) {
        const wa = formulaire.dataset.whatsapp
        const email = formulaire.dataset.email
        if (wa) {
          const url = new URL(wa)
          url.searchParams.set('text', texteDemande())
          window.open(url.toString(), '_blank', 'noopener')
          afficher('WhatsApp s’ouvre avec votre demande : il ne reste qu’à l’envoyer.', true)
        } else if (email) {
          location.href = `mailto:${email}?subject=${encodeURIComponent('Demande de devis')}&body=${encodeURIComponent(texteDemande())}`
        } else {
          afficher('Le formulaire sera relié très bientôt : merci de réessayer plus tard.', false)
        }
        return
      }
      bouton.disabled = true
      bouton.textContent = 'Envoi en cours…'
      try {
        const reponse = await fetch(formulaire.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(formulaire),
        })
        const resultat = (await reponse.json().catch(() => ({}))) as { success?: boolean }
        if (!reponse.ok || !resultat.success) throw new Error(`HTTP ${reponse.status}`)
        formulaire.reset()
        afficher('Merci ! Votre demande est bien envoyée, nous vous recontactons rapidement.', true)
      } catch (erreur) {
        console.warn('[contact] envoi échoué', erreur)
        const repli = formulaire.dataset.whatsapp ? ', ou écrivez-nous directement sur WhatsApp' : ''
        afficher(`L’envoi n’a pas abouti (connexion instable ?). Réessayez${repli}.`, false)
      } finally {
        bouton.disabled = false
        bouton.textContent = 'Envoyer la demande'
      }
    })
  }
</script>
