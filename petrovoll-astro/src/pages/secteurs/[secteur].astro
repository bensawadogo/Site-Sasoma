---
/**
 * Page secteur — PRERENDUE (getStaticPaths sur les 5 secteurs).
 * Affiche la description riche du secteur + ses produits (ProduitGrid).
 *
 * TODO [contenu] : creer les 5 fichiers secteurs via /keystatic.
 * TODO [seo] : CollectionPage JSON-LD + liens croises vers llms.txt.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content'

import ProduitGrid from '@/components/produits/ProduitGrid.astro'
import PageLayout from '@/layouts/PageLayout.astro'

export const prerender = true

export async function getStaticPaths() {
  const secteurs = await getCollection('secteurs')
  return secteurs.map((s) => ({ params: { secteur: s.id }, props: { secteur: s } }))
}

interface Props { secteur: CollectionEntry<'secteurs'> }
const { secteur } = Astro.props
// Astro 5 Content Layer : render(entry) comme fonction libre (voir [slug].astro).
const { Content } = await render(secteur)
const produits = await getCollection('produits')
const items = produits
  .filter((p) => p.data.secteur === secteur.id)
  .map((p) => ({
    slug: p.id, titre: p.data.titre, marque: p.data.marque,
    secteur: p.data.secteur, disponible: p.data.disponible,
    estProduitPhare: p.data.estProduitPhare, visuel: undefined,
  }))
---

<PageLayout
  titre={`${secteur.data.nom} — PETROVOLL`}
  description={`Découvrez notre offre ${secteur.data.nom} en Afrique de l’Ouest.`}
  canonicalChemin={`/secteurs/${secteur.id}`}
>
  <div class="container-page py-10 lg:py-14">
    <p class="text-xs font-semibold uppercase tracking-widest text-gold">Secteur</p>
    <h1 class="mt-2 text-3xl sm:text-4xl lg:text-5xl">{secteur.data.nom}</h1>
    <span class="section-line" aria-hidden="true" />

    <div class="rich-text mt-6 max-w-3xl">
      <Content />
    </div>

    <h2 class="mt-12 text-2xl lg:text-3xl">Produits — {secteur.data.nom}</h2>
    <div class="mt-6">
      <ProduitGrid produits={items} />
    </div>
  </div>
</PageLayout>
