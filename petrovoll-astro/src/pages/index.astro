---
/**
 * ═══════════════════════════════════════════════════════════════════════════
 *  Home — index.astro (PRÉRENDUE : export const prerender = true)
 * ═══════════════════════════════════════════════════════════════════════════
 *  Composition mobile-first (ordre DOM = ordre mobile) :
 *   1. HeroSection    → H1 + CTA + island 3D (texte AVANT la 3D sur mobile)
 *   2. ProduitPhare   → spotlight PETROVOLL (section dominante, 1.5× plus grande)
 *   3. SecteursGrid   → les 5 secteurs en cards
 *   4. StatsSection   → chiffres clés (compteurs animés, zero-JS sans IO)
 *   5. ContactCTA     → appel à l'action B2B (devis / WhatsApp / téléphone)
 *
 *  SEO : Organization + LocalBusiness injectés via `schema` (BaseLayout ajoute
 *  déjà le JSON-LD de base ; ici on complète avec l'implantation physique).
 *
 *  TODO [contenu] :
 *   - [ ] Remplacer titres/paragraphes par les textes validés client
 *   - [ ] Choisir le produit phare via Keystatic (estProduitPhare = true)
 *   - [ ] Renseigner geo + openingHoursSpecification dès que connus
 */
import { getCollection } from 'astro:content'

import ContactCTA from '@/components/home/ContactCTA.astro'
import HeroSection from '@/components/home/HeroSection.astro'
import ProduitPhare from '@/components/home/ProduitPhare.astro'
import SecteursGrid from '@/components/home/SecteursGrid.astro'
import StatsSection from '@/components/home/StatsSection.astro'
import PageLayout from '@/layouts/PageLayout.astro'

export const prerender = true

const TITRE = 'PETROVOLL — Distribution multi-secteurs en Afrique de l’Ouest'
const DESCRIPTION =
  'Huiles moteur PETROVOLL, transport, import-export, pneumatiques et fournitures de bureau : un partenaire unique en Afrique de l’Ouest.'

/* ── Données (build-time, zéro JS client) ───────────────────────────────── */
const produits = await getCollection('produits')
const secteurs = await getCollection('secteurs')
const produitPhare = produits.find((p) => p.data.estProduitPhare) ?? produits[0]

/* ── JSON-LD complémentaires (BaseLayout ajoute déjà Organization) ───────── */
const schemaSupplementaire: Array<Record<string, unknown>> = [
  {
    '@type': 'LocalBusiness',
    // TODO [seo] : remplacer par la raison sociale + adresse exacte du client.
    name: 'PETROVOLL',
    areaServed: 'Afrique de l’Ouest',
    // TODO [seo] : ajouter `geo`, `openingHoursSpecification`, `telephone`.
  },
]
---

<PageLayout titre={TITRE} description={DESCRIPTION} schema={schemaSupplementaire}>
  <HeroSection />
  {produitPhare && <ProduitPhare slug={produitPhare.id} />}
  <SecteursGrid secteurs={secteurs.map((s) => s.id)} />
  <StatsSection />
  <ContactCTA />
</PageLayout>
