---
/**
 * Accueil — page prérendue. Ordre du DOM = ordre sur mobile :
 * hero (bidon 3D) → produit phare → secteurs → chiffres clés → devis.
 * Chaque section lit son contenu dans l'admin et se masque si elle est vide.
 */
import ContactCTA from '@/components/home/ContactCTA.astro'
import HeroSection from '@/components/home/HeroSection.astro'
import ProduitPhare from '@/components/home/ProduitPhare.astro'
import SecteursGrid from '@/components/home/SecteursGrid.astro'
import StatsSection from '@/components/home/StatsSection.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { getParametres, getProduitVedette } from '@/lib/contenu'

export const prerender = true

const [parametres, produitVedette] = await Promise.all([getParametres(), getProduitVedette()])

const TITRE = `${parametres.nomSociete} — Lubrifiants, transport et distribution au Burkina Faso`
const DESCRIPTION =
  parametres.slogan ??
  'Lubrifiants Petrovöll, transport, import-export, pneumatiques et fournitures de bureau : un partenaire unique au Burkina Faso.'
---

<PageLayout titre={TITRE} titreComplet description={DESCRIPTION}>
  <HeroSection />
  {produitVedette && <ProduitPhare produit={produitVedette} />}
  <SecteursGrid />
  <StatsSection />
  <ContactCTA />
</PageLayout>
