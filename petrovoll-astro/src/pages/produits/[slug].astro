---
/**
 * Fiche produit — une page prérendue par produit de l'admin.
 * JSON-LD Product (+ Offer en FCFA quand un prix est renseigné).
 */
import { getImage } from 'astro:assets'
import { getEntry, render } from 'astro:content'

import ProduitDetail from '@/components/produits/ProduitDetail.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { getProduits, urlSite, type Produit } from '@/lib/contenu'
import { extraitTexte } from '@/lib/format'

export const prerender = true

export async function getStaticPaths() {
  const produits = await getProduits()
  return produits.map((produit) => ({ params: { slug: produit.id }, props: { produit } }))
}

interface Props {
  produit: Produit
}
const { produit } = Astro.props
const { Content } = await render(produit)
const { nom, photos, prix, disponible, marque, reference, secteur } = produit.data

const nomSecteur = secteur ? (await getEntry('secteurs', secteur))?.data.nom : undefined
const urlPage = new URL(`/produits/${produit.id}`, urlSite(Astro.site)).toString()
const description = extraitTexte(produit.body) || `${nom} — prix et disponibilité.`
// Aperçu de partage (WhatsApp, Facebook) : JPEG 1200 px, format lu partout,
// plutôt que la photo d'origine du téléphone (plusieurs Mo).
const imagePartage = photos[0]
  ? new URL((await getImage({ src: photos[0], width: 1200, format: 'jpeg', quality: 80 })).src, urlSite(Astro.site)).toString()
  : undefined

const schema: Array<Record<string, unknown>> = [
  {
    '@type': 'Product',
    name: nom,
    description,
    ...(marque ? { brand: { '@type': 'Brand', name: marque } } : {}),
    ...(reference ? { sku: reference } : {}),
    ...(nomSecteur ? { category: nomSecteur } : {}),
    ...(imagePartage ? { image: imagePartage } : {}),
    ...(prix != null
      ? {
          offers: {
            '@type': 'Offer',
            price: prix,
            priceCurrency: 'XOF',
            availability: disponible ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
            url: urlPage,
          },
        }
      : {}),
  },
]
---

<PageLayout
  titre={nom}
  description={description}
  ogType="product"
  ogImage={imagePartage}
  canonicalChemin={`/produits/${produit.id}`}
  schema={schema}
>
  <div class="container-page py-8 lg:py-14">
    <nav aria-label="Fil d'Ariane" class="mb-6 text-sm text-attenue">
      <ol class="flex flex-wrap gap-2">
        <li><a href="/" class="hover:text-vif">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/produits" class="hover:text-vif">Produits</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-texte">{nom}</li>
      </ol>
    </nav>

    <ProduitDetail produit={produit} nomSecteur={nomSecteur} urlPage={urlPage}>
      <Content />
    </ProduitDetail>
  </div>
</PageLayout>
