---
/**
 * Catalogue — page prérendue. Produits et secteurs édités dans l'admin.
 * Filtre en JS natif (FiltreCatalogue) ; sans JS, tout le catalogue s'affiche.
 */
import FiltreCatalogue from '@/components/produits/FiltreCatalogue.astro'
import ProduitGrid from '@/components/produits/ProduitGrid.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { getProduits, getSecteurs } from '@/lib/contenu'

export const prerender = true

const [produits, secteurs] = await Promise.all([getProduits(), getSecteurs()])
// Seuls les secteurs qui contiennent au moins un produit ont un bouton filtre.
const secteursAvecProduits = secteurs.filter((s) => produits.some((p) => p.data.secteur === s.id))
---

<PageLayout
  titre="Catalogue et prix"
  description="Catalogue et prix : lubrifiants Petrovöll, pneumatiques, fournitures et plus. Filtrez par secteur."
>
  <div class="container-page py-10 lg:py-14">
    <p class="text-xs font-semibold uppercase tracking-widest text-vif">Catalogue</p>
    <h1 class="mt-2 text-3xl sm:text-4xl lg:text-5xl">Nos produits</h1>
    <span class="section-line" aria-hidden="true" />

    <div class="mt-8">
      {secteursAvecProduits.length > 1 || produits.length > 6 ? (
        <FiltreCatalogue secteurs={secteursAvecProduits} total={produits.length} />
      ) : null}
      <ProduitGrid produits={produits} />
    </div>
  </div>
</PageLayout>
