---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 * MobileMenu.astro — panneau de navigation mobile (priorité N°1 du projet)
 * ────────────────────────────────────────────────────────────────────────────
 *  Contraintes mobiles respectées :
 *   • chaque lien ≥ 44 px de hauteur, séparateurs tactiles clairs
 *   • fermeture par Échap, par clic sur le fond, et par SWIPE vers la gauche
 *   • verrouillage du défilement du body quand le menu est ouvert
 *   • focus rendu au bouton burger à la fermeture (accessibilité clavier)
 *   • panneau masqué via l'attribut `hidden` → absent de l'ordre de tabulation
 *     et de l'arbre d'accessibilité quand il est fermé
 */
import { getParametres } from '@/lib/contenu'

interface Props {
  liens: Array<{ libelle: string; href: string }>
  cheminCourant?: string
}
const { liens, cheminCourant = '' } = Astro.props
const { lienTelephone, whatsapp } = await getParametres()
const lienWhatsApp = whatsapp()
---

<!-- Pas d'aria-modal : le focus n'est pas piégé dans le panneau, c'est un
     simple menu déroulant (l'annoncer comme modal tromperait les lecteurs d'écran). -->
<div
  id="menu-mobile"
  class="max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-bordure bg-fond lg:hidden"
  hidden
  aria-label="Menu de navigation"
>
  <ul class="container-page flex flex-col py-2">
    {
      liens.map((lien) => (
        <li>
          <a
            href={lien.href}
            data-lien-menu
            class="flex min-h-[56px] items-center border-b border-bordure font-display text-2xl tracking-wide text-texte"
            aria-current={cheminCourant.startsWith(lien.href) ? 'page' : undefined}
          >
            {lien.libelle}
          </a>
        </li>
      ))
    }

    <li class="flex flex-col gap-3 pt-4 pb-6">
      <a href="/contact" data-lien-menu class="btn-primary w-full">Demander un devis</a>
      {
        (lienWhatsApp || lienTelephone) && (
          <div class="grid grid-cols-2 gap-3">
            {lienWhatsApp && (
              <a href={lienWhatsApp} target="_blank" rel="noopener noreferrer" class="btn-outline w-full">
                WhatsApp
              </a>
            )}
            {lienTelephone && (
              <a href={lienTelephone} class="btn-outline w-full">
                Appeler
              </a>
            )}
          </div>
        )
      }
    </li>
  </ul>
</div>

<script>
  const bouton = document.getElementById('menu-toggle')
  const panneau = document.getElementById('menu-mobile')

  if (bouton && panneau) {
    const ouvrir = () => {
      panneau.hidden = false
      bouton.setAttribute('aria-expanded', 'true')
      bouton.setAttribute('aria-label', 'Fermer le menu')
      // Empêche le défilement de l'arrière-plan pendant la navigation du menu.
      // Sur <html> et non <body> : un body en overflow hidden deviendrait le
      // conteneur de défilement et décrocherait la scène collée du hero.
      document.documentElement.style.overflow = 'hidden'
    }

    const fermer = (rendreFocus = true) => {
      panneau.hidden = true
      bouton.setAttribute('aria-expanded', 'false')
      bouton.setAttribute('aria-label', 'Ouvrir le menu')
      document.documentElement.style.overflow = ''
      if (rendreFocus) bouton.focus()
    }

    const basculer = () => (panneau.hidden ? ouvrir() : fermer())

    bouton.addEventListener('click', basculer)

    // Fermeture au clavier (Échap)
    document.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape' && !panneau.hidden) fermer()
    })

    // Fermeture après un clic sur un lien (navigation)
    panneau.querySelectorAll('[data-lien-menu]').forEach((lien) => {
      lien.addEventListener('click', () => fermer(false))
    })

    // ── Fermeture par swipe vers la gauche (geste naturel sur mobile) ──────
    let departX = 0
    let departY = 0
    panneau.addEventListener(
      'touchstart',
      (evenement) => {
        departX = evenement.touches[0]?.clientX ?? 0
        departY = evenement.touches[0]?.clientY ?? 0
      },
      { passive: true },
    )

    panneau.addEventListener(
      'touchend',
      (evenement) => {
        const finX = evenement.changedTouches[0]?.clientX ?? 0
        const finY = evenement.changedTouches[0]?.clientY ?? 0
        const deltaX = finX - departX
        const deltaY = Math.abs(finY - departY)
        // Swipe horizontal franc (> 60 px) et non un défilement vertical
        if (deltaX < -60 && deltaY < 50) fermer(false)
      },
      { passive: true },
    )
  }
</script>
