---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 * MobileMenu.astro — menu de navigation mobile, plein écran
 * ────────────────────────────────────────────────────────────────────────────
 *  Contraintes mobiles respectées :
 *   • chaque lien ≥ 44 px de hauteur, séparateurs tactiles clairs
 *   • fermeture par Échap, par clic sur le fond, et par SWIPE vers la gauche
 *   • verrouillage du défilement du body quand le menu est ouvert
 *   • focus rendu au bouton burger à la fermeture (accessibilité clavier)
 *   • panneau masqué via l'attribut `hidden` → absent de l'ordre de tabulation
 *     et de l'arbre d'accessibilité quand il est fermé
 */
import IconeReseau from '@/components/ui/IconeReseau.astro'
import { getParametres } from '@/lib/contenu'

interface Props {
  liens: Array<{ libelle: string; href: string }>
  cheminCourant?: string
}
const { liens, cheminCourant = '' } = Astro.props
const { lienTelephone, whatsapp, reseaux } = await getParametres()
const lienWhatsApp = whatsapp()
const lienFacebook = reseaux.find((r) => r.plateforme === 'facebook')?.url
---

<!-- Menu plein écran (Ben, 09/10) : fond blanc, grands liens numérotés qui entrent l'un après
     l'autre, devis et contacts en bas. Pas d'aria-modal : le focus n'est pas piégé. -->
<div id="menu-mobile" class="menu-plein lg:hidden" hidden aria-label="Menu de navigation">
  <div class="menu-plein-corps container-page">
    <ul class="flex flex-col">
      {
        liens.map((lien, i) => (
          <li style={`--i:${i}`}>
            <a
              href={lien.href}
              data-lien-menu
              class="menu-lien"
              aria-current={cheminCourant.startsWith(lien.href) ? 'page' : undefined}
            >
              <span class="menu-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {lien.libelle}
              <svg class="menu-fleche" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="menu-pied" style={`--i:${liens.length}`}>
      <a href="/contact#devis" data-lien-menu class="btn-primary w-full">Demander un devis</a>
      <!-- WhatsApp toujours présent (formulaire de devis tant que le numéro n'est pas saisi) ;
           Facebook dès que la page est renseignée dans l'admin (Réseaux sociaux). -->
      <div class="grid grid-cols-2 gap-3">
        <a
          href={lienWhatsApp ?? '/contact#devis'}
          target={lienWhatsApp ? '_blank' : undefined}
          rel={lienWhatsApp ? 'noopener noreferrer' : undefined}
          data-lien-menu
          class:list={['menu-reseau menu-reseau--wa', !lienFacebook && 'col-span-2']}
        >
          <IconeReseau nom="whatsapp" class="h-5 w-5" /> WhatsApp
        </a>
        {
          lienFacebook && (
            <a href={lienFacebook} target="_blank" rel="noopener noreferrer" class="menu-reseau menu-reseau--fb">
              <IconeReseau nom="facebook" class="h-5 w-5" /> Facebook
            </a>
          )
        }
      </div>
      {
        lienTelephone && (
          <a href={lienTelephone} class="menu-secondaire">
            Appeler
          </a>
        )
      }
      <p class="text-xs uppercase tracking-[0.2em] text-attenue">Lubrifiants Petrovöll · Burkina Faso</p>
    </div>
  </div>
</div>

<style>
  .menu-plein {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: #0b1b33;
    background:
      radial-gradient(90% 50% at 100% 0%, rgb(233 113 26 / 0.07), transparent 60%),
      #ffffff;
  }
  .menu-plein-corps {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding-top: 6.5rem;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
  }
  .menu-lien {
    display: flex;
    min-height: 72px;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid #e3e9f1;
    font-family: var(--font-display);
    font-size-adjust: 0.4;
    word-spacing: 0.14em;
    font-weight: 600;
    font-size: clamp(2.6rem, 11vw, 3.6rem);
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .menu-lien[aria-current='page'] {
    color: #c2410c;
  }
  .menu-num {
    width: 2rem;
    font-family: inherit;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    color: #8a9ab0;
  }
  .menu-fleche {
    margin-left: auto;
    width: 1.6rem;
    height: 1.6rem;
    opacity: 0.5;
    transition:
      transform 0.25s,
      opacity 0.25s;
  }
  .menu-lien:hover .menu-fleche,
  .menu-lien:focus-visible .menu-fleche {
    transform: translateX(4px);
    opacity: 1;
  }
  .menu-pied {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .menu-secondaire {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid #c9d3e0;
    border-radius: 0.5rem;
    font-weight: 600;
    color: #0b1b33;
  }
  .menu-reseau {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 0.75rem;
    font-weight: 700;
    color: #fff;
    box-shadow: 0 10px 22px -12px rgb(11 27 51 / 0.5);
  }
  .menu-reseau--wa {
    background: #25d366;
  }
  .menu-reseau--fb {
    background: #1877f2;
  }
  /* Entrée : fond en fondu, liens qui montent l'un après l'autre. */
  @media (prefers-reduced-motion: no-preference) {
    .menu-plein:not([hidden]) {
      animation: menu-fondu 0.3s ease-out;
    }
    .menu-plein:not([hidden]) li,
    .menu-plein:not([hidden]) .menu-pied {
      animation: menu-monter 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(0.06s * var(--i) + 0.08s);
    }
  }
  @keyframes menu-fondu {
    from {
      opacity: 0;
    }
  }
  @keyframes menu-monter {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  /* Barre du logo au-dessus du menu ouvert : verre bien blanc, croix à la place du burger. */
  :global(#navbar[data-menu='ouvert'] .verre) {
    background: rgb(255 255 255 / 0.92);
  }
  :global(#navbar[data-menu='ouvert'] .burger .trait-milieu) {
    opacity: 0;
  }
  :global(#navbar[data-menu='ouvert'] .burger .trait-haut) {
    transform: translateY(6px) rotate(45deg);
  }
  :global(#navbar[data-menu='ouvert'] .burger .trait-bas) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  const bouton = document.getElementById('menu-toggle')
  const panneau = document.getElementById('menu-mobile')

  if (bouton && panneau) {
    const ouvrir = () => {
      panneau.hidden = false
      document.getElementById('navbar')?.setAttribute('data-menu', 'ouvert')
      bouton.setAttribute('aria-expanded', 'true')
      bouton.setAttribute('aria-label', 'Fermer le menu')
      // Empêche le défilement de l'arrière-plan pendant la navigation du menu.
      // Sur <html> et non <body> : un body en overflow hidden deviendrait le
      // conteneur de défilement et décrocherait la scène collée du hero.
      document.documentElement.style.overflow = 'hidden'
    }

    const fermer = (rendreFocus = true) => {
      panneau.hidden = true
      document.getElementById('navbar')?.removeAttribute('data-menu')
      bouton.setAttribute('aria-expanded', 'false')
      bouton.setAttribute('aria-label', 'Ouvrir le menu')
      document.documentElement.style.overflow = ''
      if (rendreFocus) bouton.focus()
    }

    const basculer = () => (panneau.hidden ? ouvrir() : fermer())

    bouton.addEventListener('click', basculer)

    // Fermeture au clavier (Échap)
    document.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape' && !panneau.hidden) fermer()
    })

    // Fermeture après un clic sur un lien (navigation)
    panneau.querySelectorAll('[data-lien-menu]').forEach((lien) => {
      lien.addEventListener('click', () => fermer(false))
    })

    // ── Fermeture par swipe vers la gauche (geste naturel sur mobile) ──────
    let departX = 0
    let departY = 0
    panneau.addEventListener(
      'touchstart',
      (evenement) => {
        departX = evenement.touches[0]?.clientX ?? 0
        departY = evenement.touches[0]?.clientY ?? 0
      },
      { passive: true },
    )

    panneau.addEventListener(
      'touchend',
      (evenement) => {
        const finX = evenement.changedTouches[0]?.clientX ?? 0
        const finY = evenement.changedTouches[0]?.clientY ?? 0
        const deltaX = finX - departX
        const deltaY = Math.abs(finY - departY)
        // Swipe horizontal franc (> 60 px) et non un défilement vertical
        if (deltaX < -60 && deltaY < 50) fermer(false)
      },
      { passive: true },
    )
  }
</script>
