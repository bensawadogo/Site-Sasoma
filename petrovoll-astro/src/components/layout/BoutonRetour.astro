---
/**
 * Bouton « Retour » (Ben, 09/10) : sur toutes les pages sauf l'accueil, sous la barre du logo.
 * Lien vers la page parente (fonctionne sans JS) ; si l'on vient d'une page du site, le
 * script revient plutôt à la page précédente, à la même position.
 */
const chemin = Astro.url.pathname.replace(/\/(index)?(\.html)?$/, '') || '/'
const parent = chemin.startsWith('/produits/')
  ? { href: '/produits', libelle: 'Catalogue' }
  : chemin.startsWith('/secteurs/')
    ? { href: '/#secteurs', libelle: 'Nos métiers' }
    : { href: '/', libelle: 'Accueil' }
---

{
  chemin !== '/' && (
    <div class="container-page pt-4 lg:pt-6">
      <a href={parent.href} class="bouton-retour" data-retour>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Retour<span class="sr-only"> : {parent.libelle}</span>
      </a>
    </div>
  )
}

<style>
  .bouton-retour {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid #c9d3e0;
    border-radius: 999px;
    background: #fff;
    padding: 0 1.1rem 0 0.85rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #0b1b33;
    box-shadow: 0 4px 14px rgb(11 27 51 / 0.06);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .bouton-retour:hover {
    border-color: #0b1b33;
  }
  .bouton-retour svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.2s;
  }
  .bouton-retour:hover svg {
    transform: translateX(-3px);
  }
</style>

<script>
  document.querySelector<HTMLAnchorElement>('[data-retour]')?.addEventListener('click', (e) => {
    try {
      if (document.referrer && new URL(document.referrer).origin === location.origin && history.length > 1) {
        e.preventDefault()
        history.back()
      }
    } catch {
      // Référent illisible : le lien vers la page parente suffit.
    }
  })
</script>
