---
/**
 * Footer.astro — pied de page (zéro JS). Coordonnées, réseaux, secteurs et
 * identifiants légaux viennent de l'admin ; une ligne vide n'est pas affichée.
 * Cibles tactiles ≥ 44 px.
 */
import { getParametres, getSecteurs } from '@/lib/contenu'

const [p, secteurs] = await Promise.all([getParametres(), getSecteurs()])
const lienWhatsApp = p.whatsapp()

const LIENS_ENTREPRISE = [
  { libelle: 'Catalogue', href: '/produits' },
  { libelle: 'À propos', href: '/a-propos' },
  { libelle: 'Contact & devis', href: '/contact' },
  { libelle: 'Mentions légales', href: '/mentions-legales' },
]
const NOMS_RESEAUX: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  tiktok: 'TikTok',
  linkedin: 'LinkedIn',
  youtube: 'YouTube',
}
const identifiants = [p.rccm && `RCCM ${p.rccm}`, p.ifu && `IFU ${p.ifu}`].filter(Boolean).join(' · ')
const annee = new Date().getFullYear()
const lien = 'flex min-h-[44px] items-center text-sm text-attenue hover:text-texte'
---

<footer class="zone-sombre mt-20">
  <div class="container-page grid gap-10 py-12 lg:grid-cols-4 lg:py-16">
    <div>
      <!-- Logo couleur sur plaque blanche : sur le bleu nuit, la version blanche
           perdait le globe (parties bleues transparentes) et se lisait mal. -->
      <span class="inline-flex rounded-md bg-white px-3 py-2">
        <img src="/images/logo/sasoma-horizontal.webp" alt={p.nomSociete} width="385" height="80" loading="lazy" class="h-10 w-auto" />
      </span>
      {p.slogan && <p class="mt-4 max-w-xs text-base leading-relaxed text-attenue">{p.slogan}</p>}
      {
        p.reseaux.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-3">
            {p.reseaux.map((r) => (
              <li>
                <a
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex min-h-[44px] items-center rounded border border-bordure px-3 text-xs uppercase tracking-wide text-attenue hover:text-vif"
                >
                  {NOMS_RESEAUX[r.plateforme] ?? r.plateforme}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      secteurs.length > 0 && (
        <nav aria-labelledby="footer-secteurs">
          <h2 id="footer-secteurs" class="font-display text-sm tracking-widest text-vif">SECTEURS</h2>
          <ul class="mt-4 space-y-1">
            {secteurs.map((s) => (
              <li><a href={`/secteurs/${s.id}`} class={lien}>{s.data.nom}</a></li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav aria-labelledby="footer-entreprise">
      <h2 id="footer-entreprise" class="font-display text-sm tracking-widest text-vif">ENTREPRISE</h2>
      <ul class="mt-4 space-y-1">
        {LIENS_ENTREPRISE.map((l) => <li><a href={l.href} class={lien}>{l.libelle}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="font-display text-sm tracking-widest text-vif">CONTACT</h2>
      <ul class="mt-4 space-y-1 text-sm text-attenue">
        {p.adresse && <li class="whitespace-pre-line py-2">{p.adresse}</li>}
        {p.horaires && <li class="whitespace-pre-line py-2">{p.horaires}</li>}
        {p.lienTelephone && <li><a href={p.lienTelephone} class={lien}>{p.telephone}</a></li>}
        {p.email && <li><a href={`mailto:${p.email}`} class:list={[lien, 'break-all']}>{p.email}</a></li>}
        {
          lienWhatsApp && (
            <li>
              <a href={lienWhatsApp} target="_blank" rel="noopener noreferrer" class="flex min-h-[44px] items-center text-vif hover:text-vif-fort">
                WhatsApp
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-bordure">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-attenue sm:flex-row sm:items-center sm:justify-between">
      <p>© {annee} {p.nomSociete} — Tous droits réservés.</p>
      {identifiants && <p>{identifiants}</p>}
    </div>
  </div>
</footer>
