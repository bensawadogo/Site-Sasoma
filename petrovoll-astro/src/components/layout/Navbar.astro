---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 * Navbar.astro — barre de navigation sticky (mobile-first)
 * ────────────────────────────────────────────────────────────────────────────
 *  Barre flottante en « verre liquide » (Ben, 07-08/10) : presque transparente (on voit les
 *  nuages du hero), flou très léger et reflets spéculaires. (08/10 : la réfraction SVG des
 *  bords a été retirée : recalculée à chaque image de la vidéo du hero, elle ralentissait.)
 *  Logo d'origine en couleur partout ; au-dessus d'une zone sombre (.zone-sombre : hero,
 *  produit phare…), le verre se charge un peu plus de blanc. Burger ≥ 44 px, liens en lg:.
 */
import MobileMenu from '@/components/layout/MobileMenu.astro'

const LIENS = [
  { libelle: 'Produits', href: '/produits' },
  { libelle: 'Nos métiers', href: '/#secteurs' },
  { libelle: 'À propos', href: '/a-propos' },
  { libelle: 'Contact', href: '/contact' },
]

const cheminCourant = Astro.url.pathname
---

<header id="navbar" class="fixed inset-x-0 top-0 z-40 px-2 pt-2 lg:px-4 lg:pt-3" data-sur="clair">
  <nav class="verre relative z-10 container-page flex h-14 items-center justify-between gap-3 rounded-2xl lg:h-16" aria-label="Navigation principale">
    <a href="/" class="flex shrink-0 items-center" aria-label="SASOMA — retour à l'accueil">
      <img
        src="/images/logo/sasoma-horizontal.webp"
        alt="SASOMA"
        width="385"
        height="80"
        class="logo-clair h-8 w-auto lg:h-10"
        fetchpriority="high"
      />
    </a>

    <!-- Liens desktop uniquement (mobile-first : cachés par défaut) -->
    <ul class="hidden items-center gap-8 lg:flex">
      {
        LIENS.map((lien) => (
          <li>
            <a
              href={lien.href}
              class="lien text-sm font-medium uppercase tracking-wide transition-colors"
              aria-current={cheminCourant.startsWith(lien.href) ? 'page' : undefined}
            >
              {lien.libelle}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <!-- CTA commercial : visible sur tous les écrans (parcours B2B) -->
      <a href="/contact#devis" class="btn-primary hidden sm:inline-flex"> Devis </a>

      <!-- Burger (mobile / tablette) : 44×44 px minimum -->
      <button
        type="button"
        id="menu-toggle"
        class="burger inline-flex size-11 items-center justify-center rounded-xl lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path class="trait-haut" d="M3 6h18" stroke-linecap="round" />
          <path class="trait-milieu" d="M3 12h18" stroke-linecap="round" />
          <path class="trait-bas" d="M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <MobileMenu liens={LIENS} cheminCourant={cheminCourant} />
</header>

<style>
  /* ── Verre clair (au-dessus d'un fond clair) ─────────────────────────────── */
  .verre {
    position: relative;
    isolation: isolate;
    color: #0b1b33;
    background: rgb(255 255 255 / 0.9);
    border: 1px solid rgb(255 255 255 / 0.6);
    box-shadow:
      inset 1.5px 1.5px 0 rgb(255 255 255 / 0.8),
      inset -1px -1px 0 rgb(255 255 255 / 0.25),
      inset 0 0 18px rgb(255 255 255 / 0.25),
      0 10px 30px rgb(5 11 24 / 0.16);
    transition:
      background-color 0.4s,
      color 0.4s;
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .verre {
      background: rgb(255 255 255 / 0.2);
      -webkit-backdrop-filter: blur(2px) saturate(1.35) brightness(1.08);
      backdrop-filter: blur(2px) saturate(1.35) brightness(1.08);
    }
  }
  /* Reflets spéculaires : lueur en haut à gauche, liseré qui fait le tour comme sur une goutte. */
  .verre::before,
  .verre::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: -1;
  }
  .verre::before {
    background:
      radial-gradient(90% 160% at 12% -60%, rgb(255 255 255 / 0.55), transparent 50%),
      radial-gradient(60% 120% at 95% 160%, rgb(255 255 255 / 0.2), transparent 55%);
  }
  .verre::after {
    padding: 1px;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.05) 35%, rgb(255 255 255 / 0.05) 65%, rgb(255 255 255 / 0.6));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  .lien {
    color: color-mix(in srgb, currentColor 82%, transparent);
  }
  .lien:hover {
    color: currentColor;
  }
  .burger path {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.25s,
      opacity 0.2s;
  }
  .burger {
    border: 1px solid rgb(255 255 255 / 0.55);
    background: rgb(255 255 255 / 0.25);
  }

  /* ── Au-dessus d'une zone sombre (dont le hero) : le verre se charge un peu plus de blanc
     pour que le logo d'origine (globe, route, couleurs) reste lisible ; les nuages passent
     toujours à travers (Ben, 08/10 : « on ne voit pas les éléments du logo » en version blanche). */
  #navbar[data-sur='sombre'] .verre {
    background: rgb(255 255 255 / 0.5);
  }

  /* Appareil faible : ni flou ni réfraction en direct (coûteux sur un petit processeur graphique). */
  :global([data-appareil='faible']) #navbar .verre {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    background: rgb(255 255 255 / 0.94);
    color: #0b1b33;
  }
</style>

<script>
  const header = document.getElementById('navbar')!
  const verre = header.querySelector<HTMLElement>('.verre')!

  /** Verre fumé quand le centre de la barre passe au-dessus d'une zone sombre. */
  let attente = false
  function majFond() {
    attente = false
    const r = verre.getBoundingClientRect()
    const sous = document.elementsFromPoint(innerWidth / 2, r.top + r.height / 2).find((e) => !header.contains(e))
    header.dataset.sur = sous?.closest('.zone-sombre') ? 'sombre' : 'clair'
  }
  const demander = () => {
    if (!attente) {
      attente = true
      requestAnimationFrame(majFond)
    }
  }
  addEventListener('scroll', demander, { passive: true })
  addEventListener('resize', demander)
  // Au chargement : à l'image suivante, pas tout de suite (lecture de géométrie forcée).
  demander()

</script>
