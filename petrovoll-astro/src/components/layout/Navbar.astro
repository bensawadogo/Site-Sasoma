---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 * Navbar.astro — barre de navigation sticky (mobile-first)
 * ────────────────────────────────────────────────────────────────────────────
 *  Barre blanche fixe avec le logo SASOMA en couleur (fond clair = logo
 *  d'origine, sans version modifiée). Burger ≥ 44 px sur mobile, liens en lg:.
 *  Aucun JS de défilement : la barre est toujours opaque.
 */
import MobileMenu from '@/components/layout/MobileMenu.astro'

const LIENS = [
  { libelle: 'Produits', href: '/produits' },
  { libelle: 'Nos métiers', href: '/#secteurs' },
  { libelle: 'À propos', href: '/a-propos' },
  { libelle: 'Contact', href: '/contact' },
]

const cheminCourant = Astro.url.pathname
---

<header id="navbar" class="fixed inset-x-0 top-0 z-40 border-b border-bordure bg-fond">
  <nav class="container-page flex h-16 items-center justify-between gap-3 lg:h-20" aria-label="Navigation principale">
    <a href="/" class="flex shrink-0 items-center" aria-label="SASOMA — retour à l'accueil">
      <img
        src="/images/logo/sasoma-horizontal.webp"
        alt="SASOMA"
        width="385"
        height="80"
        class="h-9 w-auto lg:h-11"
        fetchpriority="high"
      />
    </a>

    <!-- Liens desktop uniquement (mobile-first : cachés par défaut) -->
    <ul class="hidden items-center gap-8 lg:flex">
      {
        LIENS.map((lien) => (
          <li>
            <a
              href={lien.href}
              class="text-sm font-medium uppercase tracking-wide text-attenue transition-colors hover:text-texte"
              aria-current={cheminCourant.startsWith(lien.href) ? 'page' : undefined}
            >
              {lien.libelle}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <!-- CTA commercial : visible sur tous les écrans (parcours B2B) -->
      <a href="/contact" class="btn-primary hidden sm:inline-flex"> Devis </a>

      <!-- Burger (mobile / tablette) : 44×44 px minimum -->
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex size-11 items-center justify-center rounded border border-bordure text-texte lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <MobileMenu liens={LIENS} cheminCourant={cheminCourant} />
</header>

