---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 * Navbar.astro — barre de navigation sticky (mobile-first)
 * ────────────────────────────────────────────────────────────────────────────
 *  Barre flottante en « verre liquide » (Ben, 07-08/10) : presque transparente (on voit les
 *  nuages du hero), bords qui réfractent ce qui passe dessous comme une lentille (filtre SVG
 *  de déplacement, carte calculée à la taille de la barre ; Chromium), reflets spéculaires.
 *  Logo d'origine en couleur partout ; au-dessus d'une zone sombre (.zone-sombre : hero,
 *  produit phare…), le verre se charge un peu plus de blanc. Burger ≥ 44 px, liens en lg:.
 */
import MobileMenu from '@/components/layout/MobileMenu.astro'

const LIENS = [
  { libelle: 'Produits', href: '/produits' },
  { libelle: 'Nos métiers', href: '/#secteurs' },
  { libelle: 'À propos', href: '/a-propos' },
  { libelle: 'Contact', href: '/contact' },
]

const cheminCourant = Astro.url.pathname
---

<header id="navbar" class="fixed inset-x-0 top-0 z-40 px-2 pt-2 lg:px-4 lg:pt-3" data-sur="clair">
  <nav class="verre container-page flex h-14 items-center justify-between gap-3 rounded-2xl lg:h-16" aria-label="Navigation principale">
    <a href="/" class="flex shrink-0 items-center" aria-label="SASOMA — retour à l'accueil">
      <img
        src="/images/logo/sasoma-horizontal.webp"
        alt="SASOMA"
        width="385"
        height="80"
        class="logo-clair h-8 w-auto lg:h-10"
        fetchpriority="high"
      />
    </a>

    <!-- Liens desktop uniquement (mobile-first : cachés par défaut) -->
    <ul class="hidden items-center gap-8 lg:flex">
      {
        LIENS.map((lien) => (
          <li>
            <a
              href={lien.href}
              class="lien text-sm font-medium uppercase tracking-wide transition-colors"
              aria-current={cheminCourant.startsWith(lien.href) ? 'page' : undefined}
            >
              {lien.libelle}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <!-- CTA commercial : visible sur tous les écrans (parcours B2B) -->
      <a href="/contact" class="btn-primary hidden sm:inline-flex"> Devis </a>

      <!-- Burger (mobile / tablette) : 44×44 px minimum -->
      <button
        type="button"
        id="menu-toggle"
        class="burger inline-flex size-11 items-center justify-center rounded-xl lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <MobileMenu liens={LIENS} cheminCourant={cheminCourant} />
</header>

<!-- Filtre de réfraction du verre : la carte de déplacement est dessinée par le script. -->
<svg class="filtres" width="0" height="0" aria-hidden="true" focusable="false">
  <filter id="verre-liquide" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feImage id="verre-carte" x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="carte"></feImage>
    <feDisplacementMap in="SourceGraphic" in2="carte" scale="44" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
  </filter>
</svg>

<style>
  .filtres {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  /* ── Verre clair (au-dessus d'un fond clair) ─────────────────────────────── */
  .verre {
    position: relative;
    isolation: isolate;
    color: #0b1b33;
    background: rgb(255 255 255 / 0.9);
    border: 1px solid rgb(255 255 255 / 0.6);
    box-shadow:
      inset 1.5px 1.5px 0 rgb(255 255 255 / 0.8),
      inset -1px -1px 0 rgb(255 255 255 / 0.25),
      inset 0 0 18px rgb(255 255 255 / 0.25),
      0 10px 30px rgb(5 11 24 / 0.16);
    transition:
      background-color 0.4s,
      color 0.4s;
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .verre {
      background: rgb(255 255 255 / 0.28);
      -webkit-backdrop-filter: blur(5px) saturate(1.7) brightness(1.06);
      backdrop-filter: blur(5px) saturate(1.7) brightness(1.06);
    }
  }
  /* Réfraction des bords (Chromium) : lentille ; flou très léger, les nuages restent nets. */
  :global(html.verre-liquide) .verre {
    background: rgb(255 255 255 / 0.16);
    backdrop-filter: url(#verre-liquide) blur(1px) saturate(1.35) brightness(1.08);
  }
  /* Reflets spéculaires : lueur en haut à gauche, liseré qui fait le tour comme sur une goutte. */
  .verre::before,
  .verre::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: -1;
  }
  .verre::before {
    background:
      radial-gradient(90% 160% at 12% -60%, rgb(255 255 255 / 0.55), transparent 50%),
      radial-gradient(60% 120% at 95% 160%, rgb(255 255 255 / 0.2), transparent 55%);
  }
  .verre::after {
    padding: 1px;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.05) 35%, rgb(255 255 255 / 0.05) 65%, rgb(255 255 255 / 0.6));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  .lien {
    color: color-mix(in srgb, currentColor 82%, transparent);
  }
  .lien:hover {
    color: currentColor;
  }
  .burger {
    border: 1px solid rgb(255 255 255 / 0.55);
    background: rgb(255 255 255 / 0.25);
  }

  /* ── Au-dessus d'une zone sombre (dont le hero) : le verre se charge un peu plus de blanc
     pour que le logo d'origine (globe, route, couleurs) reste lisible ; les nuages passent
     toujours à travers (Ben, 08/10 : « on ne voit pas les éléments du logo » en version blanche). */
  #navbar[data-sur='sombre'] .verre {
    background: rgb(255 255 255 / 0.5);
  }
  :global(html.verre-liquide) #navbar[data-sur='sombre'] .verre {
    background: rgb(255 255 255 / 0.36);
  }

  /* Appareil faible : ni flou ni réfraction en direct (coûteux sur un petit processeur graphique). */
  :global([data-appareil='faible']) #navbar .verre {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    background: rgb(255 255 255 / 0.94);
    color: #0b1b33;
  }
</style>

<script>
  import { lireNiveau } from '@/lib/capacite-appareil'

  const header = document.getElementById('navbar')!
  const verre = header.querySelector<HTMLElement>('.verre')!
  const carte = document.getElementById('verre-carte')!
  const niveau = lireNiveau()

  /** Verre fumé quand le centre de la barre passe au-dessus d'une zone sombre. */
  let attente = false
  function majFond() {
    attente = false
    const r = verre.getBoundingClientRect()
    const sous = document.elementsFromPoint(innerWidth / 2, r.top + r.height / 2).find((e) => !header.contains(e))
    header.dataset.sur = sous?.closest('.zone-sombre') ? 'sombre' : 'clair'
  }
  const demander = () => {
    if (!attente) {
      attente = true
      requestAnimationFrame(majFond)
    }
  }
  addEventListener('scroll', demander, { passive: true })
  addEventListener('resize', demander)
  majFond()

  /**
   * Carte de déplacement de la lentille : neutre (128) au centre ; près des bords, le fond est
   * pris plus à l'intérieur (vecteur vers le centre, croissant en carré) : les bords grossissent
   * et courbent ce qui passe dessous, comme l'épaisseur d'une goutte de verre.
   */
  function dessinerCarte() {
    const l = Math.round(verre.offsetWidth)
    const h = Math.round(verre.offsetHeight)
    if (!l || !h) return
    const rayon = parseFloat(getComputedStyle(verre).borderTopLeftRadius) || 16
    const bord = Math.min(22, h * 0.42)
    const c = document.createElement('canvas')
    c.width = l
    c.height = h
    const ctx = c.getContext('2d')!
    const img = ctx.createImageData(l, h)
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < l; x++) {
        const px = x + 0.5 - l / 2
        const py = y + 0.5 - h / 2
        // distance au bord du rectangle arrondi, et normale vers l'intérieur
        const qx = Math.max(Math.abs(px) - (l / 2 - rayon), 0)
        const qy = Math.max(Math.abs(py) - (h / 2 - rayon), 0)
        const coin = qx > 0 && qy > 0
        const d = coin ? rayon - Math.hypot(qx, qy) : Math.min(l / 2 - Math.abs(px), h / 2 - Math.abs(py))
        const t = Math.max(0, 1 - d / bord) ** 2
        let nx = 0
        let ny = 0
        if (t > 0) {
          if (coin) {
            const n = Math.hypot(qx, qy) || 1
            nx = (-Math.sign(px) * qx) / n
            ny = (-Math.sign(py) * qy) / n
          } else if (l / 2 - Math.abs(px) < h / 2 - Math.abs(py)) nx = -Math.sign(px)
          else ny = -Math.sign(py)
        }
        const i = (y * l + x) * 4
        img.data[i] = 128 + nx * t * 127
        img.data[i + 1] = 128 + ny * t * 127
        img.data[i + 2] = 128
        img.data[i + 3] = 255
      }
    }
    ctx.putImageData(img, 0, 0)
    carte.setAttribute('href', c.toDataURL())
    carte.setAttribute('width', String(l))
    carte.setAttribute('height', String(h))
  }

  // Réfraction : Chromium seulement (backdrop-filter: url() ignoré ailleurs → flou simple),
  // et pas sur un appareil faible.
  const marques = (navigator as Navigator & { userAgentData?: { brands: { brand: string }[] } }).userAgentData?.brands ?? []
  if (marques.some((b) => /Chromium/.test(b.brand)) && niveau !== 'faible') {
    dessinerCarte()
    document.documentElement.classList.add('verre-liquide')
    new ResizeObserver(() => dessinerCarte()).observe(verre)
  }
</script>
