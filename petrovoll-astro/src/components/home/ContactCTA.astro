---
/**
 * ContactCTA.astro — encadré « devis » (textes : admin → Page d'accueil).
 * Liens natifs uniquement (tel:, wa.me, /contact) : zéro JS, cibles ≥ 48 px.
 */
import TitreAnime from '@/components/ui/TitreAnime.astro'
import { getAccueil, getParametres } from '@/lib/contenu'

const [accueil, parametres] = await Promise.all([getAccueil(), getParametres()])
const lienWhatsApp = parametres.whatsapp()
---

<section class="container-page py-14 lg:py-20" aria-labelledby="contact-cta-titre">
  <div class="reveal relative overflow-hidden rounded-lg border border-accent/30 bg-surface px-6 py-10 text-center sm:px-10 lg:py-14">
    <div
      aria-hidden="true"
      class="parallaxe pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 60% 80% at 50% 100%, rgba(230,103,17,0.14), transparent 70%);"
    >
    </div>

    <div class="relative">
      <p class="eyebrow-ed justify-center text-vif"><span class="eyebrow-num">05</span>Contact</p>
      <TitreAnime id="contact-cta-titre" class="titre-geant mx-auto mt-4 max-w-5xl" texte={accueil.appelTitre} />
      {accueil.appelTexte && <p class="mx-auto mt-4 max-w-xl text-base text-attenue">{accueil.appelTexte}</p>}

      <div class="mx-auto mt-8 flex max-w-lg flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center">
        <a href="/contact" class="btn-primary w-full sm:w-auto">Demander un devis</a>
        {
          lienWhatsApp && (
            <a href={lienWhatsApp} target="_blank" rel="noopener noreferrer" class="btn-outline w-full sm:w-auto">
              WhatsApp
            </a>
          )
        }
        {
          parametres.lienTelephone && (
            <a href={parametres.lienTelephone} class="btn-outline w-full sm:w-auto">
              Appeler
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
