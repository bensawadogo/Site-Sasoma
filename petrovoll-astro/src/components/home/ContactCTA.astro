---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 * ContactCTA.astro — appel à l'action B2B (devis / WhatsApp / téléphone)
 * ────────────────────────────────────────────────────────────────────────────
 *  Mobile-first : CTA empilés pleine largeur sur mobile, en ligne dès sm:.
 *  Zéro JS : liens <a> natifs (tel:, wa.me, /contact). Touch targets ≥ 48px.
 *
 *  TODO [contenu] :
 *   - [ ] Numéro WhatsApp via PUBLIC_WHATSAPP_NUMBER (.env) — voir HeroSection
 *   - [ ] Téléphone / email via singleton `parametresSite` (getEntry)
 *   - [ ] Texte d'accroche validé client (délais, zones livrées, MOQ)
 */
const lienWhatsApp = import.meta.env.PUBLIC_WHATSAPP_NUMBER
  ? `https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER.replace(/[^\d]/g, '')}?text=${encodeURIComponent('Bonjour, je souhaite un devis PETROVOLL.')}`
  : null
---

<section class="container-page py-14 lg:py-20" aria-labelledby="contact-cta-titre">
  <div class="reveal relative overflow-hidden rounded-lg border border-accent/30 bg-surface px-6 py-10 text-center sm:px-10 lg:py-14">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 60% 80% at 50% 100%, rgba(212,66,10,0.25), transparent 70%);"
    />

    <div class="relative">
      <h2 id="contact-cta-titre" class="text-3xl sm:text-4xl lg:text-5xl">
        Besoin d’un devis <span class="text-accent">professionnel&nbsp;?</span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-muted">
        {/* TODO [contenu] : promesse commerciale (réponse sous 24 h, livraison, MOQ). */}
        Huiles PETROVOLL, pneumatiques, fournitures : envoyez votre besoin, notre
        équipe commerciale vous répond avec un devis détaillé.
      </p>

      <div class="mx-auto mt-8 flex max-w-lg flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center">
        <a href="/contact" class="btn-primary w-full sm:w-auto">Demander un devis</a>
        {
          lienWhatsApp && (
            <a href={lienWhatsApp} target="_blank" rel="noopener noreferrer" class="btn-outline w-full sm:w-auto">
              WhatsApp
            </a>
          )
        }
        {/* TODO [contact] : <a href={`tel:${telephone}`}> avec le numéro du singleton. */}
      </div>
    </div>
  </div>
</section>
