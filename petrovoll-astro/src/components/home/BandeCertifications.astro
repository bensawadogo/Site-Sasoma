---
/**
 * BandeCertifications.astro — certifications et homologations du fabricant, en bande défilante.
 *
 * Sources : page « Our Certificates » de Petrovöll GmbH (ISO 9001:2015, ISO 14001:2015,
 * OHSAS 18001:2007) et certificats PDF du fabricant (assets/catalogues/petrovoll/certificats/ :
 * Mercedes-Benz MB 228.3 / 229.3, Volkswagen, Porsche, Volvo VDS-3, JASO, Parker Denison).
 * Badges dessinés ici, sans le logo de l'ISO : l'ISO interdit son logo aux entreprises
 * certifiées. Défilement plus lent si les animations sont coupées dans le système ; bouton pause.
 */
import TitreAnime from '@/components/ui/TitreAnime.astro'
interface Props {
  /** Titre visible (h2) ; l'accueil et « À propos » peuvent le formuler différemment. */
  titre?: string
}
const { titre = 'Qualité certifiée, du fabricant à votre moteur' } = Astro.props

/** Les trois certificats du fabricant : grandes médailles « studio » (Ben, 09/10). */
const CERTIFICATS = [
  { code: 'ISO 9001', annee: '2015', texte: 'Management de la qualité', detail: 'Chaque lot est produit et contrôlé selon un système qualité audité.' },
  { code: 'ISO 14001', annee: '2015', texte: 'Management environnemental', detail: 'Production maîtrisée : rejets, déchets et énergie suivis et réduits.' },
  { code: 'OHSAS 18001', annee: '2007', texte: 'Santé et sécurité au travail', detail: 'Des usines où la sécurité des équipes est une norme, pas une option.' },
]
/** Homologations et normes : bande défilante sous les médailles. */
const BADGES = [
  { code: 'MB 229.3', annee: 'Homologation', texte: 'Mercedes-Benz' },
  { code: 'MB 228.3', annee: 'Homologation', texte: 'Mercedes-Benz poids lourds' },
  { code: 'VW 502.00', annee: 'Homologation', texte: 'Volkswagen' },
  { code: 'C20', annee: 'Porsche Approved', texte: 'Porsche' },
  { code: 'VDS-3', annee: 'Homologation', texte: 'Volvo' },
  { code: 'JASO MA', annee: 'Homologation', texte: 'Moto 4 temps' },
  { code: 'HF-0', annee: 'Parker Denison', texte: 'Huiles hydrauliques' },
  { code: 'API SN', annee: 'Norme', texte: 'Moteurs essence' },
  { code: 'ACEA A5/B5', annee: 'Norme', texte: 'Moteurs européens' },
]
---

<section class="zone-sombre grain bande-certif bg-fond py-14 text-texte lg:py-24" aria-labelledby="certif-titre">
  <div class="container-page">
    <p class="eyebrow-ed text-vif"><span class="eyebrow-num">04</span>Certifications · Petrovöll GmbH, Allemagne</p>
    <TitreAnime id="certif-titre" class="titre-geant titre-geant--moyen mt-4 max-w-5xl" texte={titre} />
  </div>

  <ul class="container-page medailles mt-10 lg:mt-14" aria-label="Certificats du fabricant">
    {
      CERTIFICATS.map((c, i) => (
        <li class="medaille-carte" style={`--i:${i}`}>
          <span class="medaille" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <defs>
                <radialGradient id={`or-${i}`} cx="35%" cy="30%" r="80%">
                  <stop offset="0" stop-color="#fff6d8" />
                  <stop offset="0.35" stop-color="#e9c46a" />
                  <stop offset="0.7" stop-color="#b8862b" />
                  <stop offset="1" stop-color="#7a5414" />
                </radialGradient>
                <linearGradient id={`bord-${i}`} x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#fff3c4" />
                  <stop offset="0.5" stop-color="#a87a22" />
                  <stop offset="1" stop-color="#f3d27a" />
                </linearGradient>
                <path id={`cercle-${i}`} d="M60 60 m-38 0 a38 38 0 1 1 76 0 a38 38 0 1 1 -76 0" />
              </defs>
              <polygon
                points={Array.from({ length: 48 }, (_, k) => {
                  const a = (k / 48) * Math.PI * 2
                  const r = k % 2 ? 54 : 58
                  return `${(60 + r * Math.cos(a)).toFixed(2)},${(60 + r * Math.sin(a)).toFixed(2)}`
                }).join(' ')}
                fill={`url(#bord-${i})`}
              />
              <circle cx="60" cy="60" r="50" fill={`url(#or-${i})`} />
              <circle cx="60" cy="60" r="46" fill="none" stroke="#fff3c4" stroke-opacity="0.7" stroke-width="0.8" />
              <circle cx="60" cy="60" r="30" fill="none" stroke="#6b4a10" stroke-opacity="0.35" stroke-width="0.8" />
              <text font-size="7.2" font-weight="700" letter-spacing="2.2" fill="#5a3d0c" fill-opacity="0.85">
                <textPath href={`#cercle-${i}`} startOffset="0">PETROVÖLL GMBH · GERMANY · CERTIFIED ·</textPath>
              </text>
              <path d="M47 61l9 9 17-19" fill="none" stroke="#5a3d0c" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <p class="mt-6 font-display text-[44px] leading-none tracking-wide text-white lg:text-5xl">{c.code}</p>
          <p class="mt-2 text-[11px] font-semibold uppercase tracking-[0.24em] text-[#e9c46a]">Version {c.annee}</p>
          <p class="mt-4 text-base font-semibold text-white">{c.texte}</p>
          <p class="mt-1.5 text-sm leading-relaxed text-white/60">{c.detail}</p>
        </li>
      ))
    }
  </ul>

  <p class="container-page mt-12 text-[11px] font-semibold uppercase tracking-[0.24em] text-white/50">Homologations constructeurs et normes</p>
  <div class="defile mt-4">
    <ul class="piste defile-continu" aria-label="Certifications et homologations du fabricant">
      {
        [0, 1].map((copie) =>
          BADGES.map((b) => (
            <li class="badge" aria-hidden={copie ? 'true' : undefined}>
              <span class="sceau" aria-hidden="true">
                <svg viewBox="0 0 64 64" width="44" height="44">
                  <circle cx="32" cy="32" r="29" fill="none" stroke="currentColor" stroke-width="2" />
                  <circle cx="32" cy="32" r="23" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" />
                  <path d="M21 33l7 7 15-16" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="flex flex-col">
                <span class="font-display text-2xl leading-none tracking-wide">{b.code}</span>
                <span class="mt-1 text-[0.7rem] font-semibold uppercase tracking-widest text-vif">{b.annee}</span>
                <span class="text-sm text-attenue">{b.texte}</span>
              </span>
            </li>
          )),
        )
      }
    </ul>
  </div>

  <button type="button" class="pause-defile" data-pause-defile aria-pressed="false">
    <span class="icone-pause" aria-hidden="true">❚❚</span><span class="icone-lecture" aria-hidden="true">▶</span>
    <span class="sr-only">Mettre en pause le défilement</span>
  </button>
</section>

<style>
  /* ── Médailles des certificats : studio sombre, spot au-dessus, reflet doré qui passe. ── */
  /* Téléphone : les médailles défilent à l'horizontale (une et demie visibles), pas en colonne. */
  .medailles {
    display: flex;
    gap: 0.875rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }
  .medailles::-webkit-scrollbar {
    display: none;
  }
  .medailles > li {
    flex: 0 0 78%;
    scroll-snap-align: center;
  }
  @media (min-width: 768px) {
    .medailles {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
      overflow: visible;
    }
  }
  .medaille-carte {
    position: relative;
    overflow: hidden;
    padding: 2.25rem 1.75rem 2rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.25rem;
    background:
      radial-gradient(70% 55% at 50% 0%, rgb(255 255 255 / 0.12), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.01));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 30px 60px -30px rgb(0 0 0 / 0.7);
    text-align: center;
  }
  /* Reflet qui balaie la carte au survol (et une fois à l'apparition). */
  .medaille-carte::after {
    content: '';
    position: absolute;
    inset: -50% -20%;
    background: linear-gradient(105deg, transparent 40%, rgb(255 236 179 / 0.14) 50%, transparent 60%);
    transform: translateX(-60%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .medaille-carte:hover::after {
      transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
      transform: translateX(60%);
    }
    .medaille-carte:hover .medaille {
      transform: translateY(-4px) rotate(-4deg);
    }
  }
  .medaille {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 8.5rem;
    height: 8.5rem;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .medaille svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 18px 18px rgb(0 0 0 / 0.55)) drop-shadow(0 0 30px rgb(233 196 106 / 0.18));
  }
  /* Ombre de contact sous la médaille, comme sur une table de studio. */
  .medaille::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.9rem;
    width: 70%;
    height: 0.7rem;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.55), transparent);
  }
  .defile {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .piste {
    display: flex;
    gap: 1rem;
    width: max-content;
    padding: 0.25rem 0;
    /* Sens inverse de la bande des constructeurs. */
    animation: defiler 50s linear infinite reverse;
  }
  .defile:hover .piste {
    animation-play-state: paused;
  }
  .badge {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.9rem;
    min-width: 15.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 1rem;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.02));
  }
  .sceau {
    display: grid;
    flex: none;
    place-items: center;
    color: var(--color-vif);
  }
  @keyframes defiler {
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }
  /* Pause : survol, ou bouton (WCAG 2.2.2 : tout défilement automatique doit pouvoir s'arrêter). */
  .pause-defile {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 1rem auto 0;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.8rem;
    opacity: 0.55;
    transition: opacity 0.2s;
  }
  .pause-defile:hover,
  .pause-defile:focus-visible {
    opacity: 1;
  }
  .icone-lecture,
  .en-pause .icone-pause {
    display: none;
  }
  .en-pause .icone-lecture {
    display: inline;
  }
  .en-pause .piste {
    animation-play-state: paused;
  }
  /* Animations désactivées dans le système : le défilement continue, plus lentement
     (demande de Ben, 06/10) ; le bouton permet toujours de l'arrêter. */
  @media (prefers-reduced-motion: reduce) {
    .piste {
      animation-duration: 100s;
    }
  }
</style>

<script>
  import '@/scripts/defile-bandes'
</script>
