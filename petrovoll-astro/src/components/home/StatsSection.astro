---
/**
 * StatsSection.astro — chiffres clés saisis par le client (Page d'accueil).
 * Masquée tant qu'aucun chiffre n'est renseigné : on ne publie jamais de
 * chiffres inventés.
 *
 * Le compteur n'anime que la partie numérique au début du texte (« 500+ »,
 * « 24 h ») ; sans JS, la valeur finale est déjà dans le HTML.
 */
import { getAccueil } from '@/lib/contenu'

const { chiffres } = await getAccueil()
---

{
  chiffres.length > 0 && (
    <section class="border-y border-bordure bg-surface" aria-labelledby="stats-titre">
      <div class="container-page py-12 lg:py-16">
        <h2 id="stats-titre" class="sr-only">Chiffres clés</h2>
        <dl class="grid grid-cols-2 gap-8 text-center lg:grid-cols-4" data-compteurs>
          {chiffres.map((c) => (
            <div class="reveal flex flex-col-reverse">
              {/* <dt> avant <dd> (ordre valide et lu correctement), chiffre affiché au-dessus. */}
              <dt class="mt-2 text-xs uppercase tracking-wide text-attenue">{c.libelle}</dt>
              <dd class="font-display text-4xl text-vif lg:text-5xl" data-compteur>
                {c.valeur}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<script>
  const conteneur = document.querySelector<HTMLElement>('[data-compteurs]')
  const mouvementReduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  const animer = (element: HTMLElement) => {
    const texte = element.textContent?.trim() ?? ''
    const [, nombre, suite] = texte.match(/^(\d+)(.*)$/s) ?? []
    if (!nombre) return // « — », « N/A »… : rien à animer
    const cible = Number(nombre)
    const debut = performance.now()
    const frame = (maintenant: number) => {
      const progression = Math.min((maintenant - debut) / 1200, 1)
      const valeur = Math.round(cible * (1 - Math.pow(1 - progression, 3)))
      element.textContent = `${valeur}${suite}`
      if (progression < 1) requestAnimationFrame(frame)
    }
    requestAnimationFrame(frame)
  }

  if (conteneur && !mouvementReduit && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entree]) => {
        if (!entree.isIntersecting) return
        conteneur.querySelectorAll<HTMLElement>('[data-compteur]').forEach(animer)
        observer.disconnect()
      },
      { threshold: 0.4 },
    )
    observer.observe(conteneur)
  }
</script>
