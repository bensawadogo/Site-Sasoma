---
/**
 * ProduitPhare.astro — le produit « mis en avant » (case cochée dans l'admin),
 * juste sous le hero : visuel, prix, extrait, liens.
 *
 * Visuel : le bidon 3D quand le produit est celui du modèle (un STÄRK
 * Petrovöll) ; sinon la première photo du produit, ou son visuel de repli.
 * Le modèle 3D représente un STÄRK : on ne le montre pas pour un autre produit.
 */
import BidonScene from '@/components/3d/BidonScene.astro'
import PhotoProduit from '@/components/produits/PhotoProduit.astro'
import type { Produit } from '@/lib/contenu'
import { extraitTexte, formaterPrix } from '@/lib/format'

interface Props {
  produit: Produit
}
const { produit } = Astro.props
const { nom, photos, prix, conditionnement, marque, secteur } = produit.data
const extrait = extraitTexte(produit.body, 180)
const bidon3d = /petrov/i.test(marque ?? '') && /st[äa]rk/i.test(nom)
---

<section class="relative overflow-hidden bg-surface" aria-labelledby="produit-phare-titre">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(ellipse 70% 60% at 30% 50%, rgba(230,103,17,0.12), transparent 70%);"
  >
  </div>

  <div class="container-page relative grid items-center gap-10 py-14 lg:grid-cols-2 lg:gap-16 lg:py-24">
    <div class="reveal mx-auto aspect-square w-full max-w-[520px] overflow-hidden rounded-md">
      {
        bidon3d ? (
          <BidonScene alt={nom} sizes="(min-width: 1024px) 520px, 100vw" />
        ) : (
          <PhotoProduit
            photo={photos[0]}
            alt={nom}
            {secteur}
            {marque}
            largeurs={[400, 800]}
            sizes="(min-width: 1024px) 520px, 100vw"
            class="h-full w-full"
          />
        )
      }
    </div>

    <div class="reveal">
      <p class="inline-flex items-center gap-2 rounded border border-vif/40 bg-vif/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-widest text-vif-fort">
        Produit phare{marque ? ` · ${marque}` : ''}
      </p>

      <h2 id="produit-phare-titre" class="mt-5 text-3xl leading-[0.95] sm:text-4xl lg:text-6xl">{nom}</h2>
      <span class="section-line" aria-hidden="true" />

      <p class="mt-4 font-display text-3xl tracking-wide text-vif">
        {formaterPrix(prix)}
        {conditionnement && <span class="ml-2 font-sans text-base text-attenue">· {conditionnement}</span>}
      </p>
      {extrait && <p class="mt-4 max-w-xl text-base leading-relaxed text-attenue sm:text-lg">{extrait}</p>}

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={`/produits/${produit.id}`} class="btn-primary w-full sm:w-auto">Voir le produit</a>
        <a href={`/contact?produit=${encodeURIComponent(nom)}#devis`} class="btn-outline w-full sm:w-auto">Demander un devis</a>
      </div>
    </div>
  </div>
</section>
