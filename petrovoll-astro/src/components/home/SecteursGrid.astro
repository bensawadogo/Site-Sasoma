---
/**
 * SecteursGrid.astro — cartes des secteurs d'activité (admin → Secteurs).
 * Ordre = champ « Position » ; icône et phrase choisies par le client.
 * Mobile : 1 colonne → 2 dès sm: → 3 dès lg:.
 */
import TitreAnime from '@/components/ui/TitreAnime.astro'
import IconeSecteur from '@/components/ui/IconeSecteur.astro'
import { Image } from 'astro:assets'

import { getSecteurs } from '@/lib/contenu'

const secteurs = await getSecteurs()
---

{
  secteurs.length > 0 && (
    <section id="secteurs" class="container-page scroll-mt-20 py-14 lg:py-20" aria-labelledby="secteurs-titre">
      <div class="max-w-5xl">
        <p class="eyebrow-ed text-vif"><span class="eyebrow-num">03</span>Nos métiers</p>
        <TitreAnime
          id="secteurs-titre"
          class="titre-geant mt-4"
          texte={secteurs.length > 1 ? `${secteurs.length} secteurs, un seul partenaire` : 'Notre métier'}
          accent={secteurs.length > 1 ? 'partenaire' : 'métier'}
        />
        <span class="section-line" aria-hidden="true" />
      </div>

      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {secteurs.map((secteur, i) => (
          <li class="reveal" style={`--i:${i % 3}`}>
            <a
              href={`/secteurs/${secteur.id}`}
              class="carte-studio group flex h-full min-h-[132px] flex-col gap-4 overflow-hidden rounded-md border border-bordure bg-surface p-5 transition-colors hover:border-accent/50"
            >
              {secteur.data.image && (
                <div class="masque-image -mx-5 -mt-5 aspect-[16/9] overflow-hidden bg-fond">
                  <Image
                    src={secteur.data.image}
                    alt=""
                    widths={[400, 640, 800]}
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    format="webp"
                    quality={72}
                    loading="lazy"
                    class="img-carte parallaxe -mt-[8%] h-[116%] w-full object-cover"
                  />
                </div>
              )}
              <span class="inline-flex h-11 w-11 items-center justify-center rounded bg-fond text-vif">
                <IconeSecteur icone={secteur.data.icone} />
              </span>
              <div>
                <h3 class="font-display text-xl tracking-wide group-hover:text-vif">{secteur.data.nom}</h3>
                {secteur.data.resume && <p class="mt-1 text-base text-attenue">{secteur.data.resume}</p>}
                <p class="mt-2 text-sm text-vif">Découvrir <span class="fleche" aria-hidden="true">→</span></p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
