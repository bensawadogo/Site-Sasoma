---
/**
 * SecteursGrid.astro — cartes des secteurs d'activité (admin → Secteurs).
 * Ordre = champ « Position » ; icône et phrase choisies par le client.
 * Mobile : 1 colonne → 2 dès sm: → 3 dès lg:.
 */
import IconeSecteur from '@/components/ui/IconeSecteur.astro'
import { Image } from 'astro:assets'

import { getSecteurs } from '@/lib/contenu'

const secteurs = await getSecteurs()
---

{
  secteurs.length > 0 && (
    <section id="secteurs" class="container-page scroll-mt-20 py-14 lg:py-20" aria-labelledby="secteurs-titre">
      <div class="reveal max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-vif">Nos métiers</p>
        <h2 id="secteurs-titre" class="mt-3 text-3xl sm:text-4xl lg:text-5xl">
          {secteurs.length > 1 ? `${secteurs.length} secteurs, un seul partenaire` : 'Notre métier'}
        </h2>
        <span class="section-line" aria-hidden="true" />
      </div>

      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {secteurs.map((secteur) => (
          <li class="reveal">
            <a
              href={`/secteurs/${secteur.id}`}
              class="group flex h-full min-h-[132px] flex-col gap-4 overflow-hidden rounded-md border border-bordure bg-surface p-5 transition-colors hover:border-accent/50"
            >
              {secteur.data.image && (
                <div class="-mx-5 -mt-5 aspect-[16/9] overflow-hidden bg-fond">
                  <Image
                    src={secteur.data.image}
                    alt=""
                    widths={[400, 640, 800]}
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    format="webp"
                    quality={72}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
              )}
              <span class="inline-flex h-11 w-11 items-center justify-center rounded bg-fond text-vif">
                <IconeSecteur icone={secteur.data.icone} />
              </span>
              <div>
                <h3 class="font-display text-xl tracking-wide group-hover:text-vif">{secteur.data.nom}</h3>
                {secteur.data.resume && <p class="mt-1 text-base text-attenue">{secteur.data.resume}</p>}
                <p class="mt-2 text-sm text-vif">Découvrir →</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
