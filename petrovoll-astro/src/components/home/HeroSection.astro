---
/**
 * HeroSection.astro — ouverture de la page d'accueil.
 * Textes édités par le client (admin → Pages → Page d'accueil).
 *
 * Mobile : titre → bidon → texte, pour que le bidon soit visible sans défiler.
 * Desktop : texte à gauche, bidon à droite. L'ordre du DOM suit le mobile.
 *
 * Le bidon 3D n'est jamais dans le chemin critique : une image WebP de 19-34 Ko
 * s'affiche d'abord, la 3D la remplace ensuite si le téléphone le permet
 * (voir BidonScene).
 */
import BidonScene from '@/components/3d/BidonScene.astro'
import { getAccueil, getParametres } from '@/lib/contenu'

const [accueil, parametres] = await Promise.all([getAccueil(), getParametres()])
const lienWhatsApp = parametres.whatsapp()
---

<section class="zone-sombre relative overflow-hidden" aria-labelledby="hero-titre">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(ellipse 80% 60% at 70% 30%, rgba(230,103,17,0.18), transparent 70%);"
  >
  </div>

  <div class="hero-grille container-page relative py-6 lg:py-20">
    <div class="hero-titre reveal">
      <p class="inline-flex items-center gap-2 rounded border border-vif/30 bg-vif/5 px-3 py-1.5 font-display text-xs uppercase tracking-widest text-vif">
        {accueil.surtitre}
      </p>

      <h1 id="hero-titre" class="mt-5 text-4xl uppercase leading-[0.95] sm:text-5xl lg:text-7xl">
        {accueil.titreDebut}
        <br />
        <span class="text-vif">{accueil.titreCouleur}</span>
        <br />
        {accueil.titreFin}
      </h1>
    </div>

    <div class="hero-bidon mx-auto aspect-square w-full max-w-[300px] sm:max-w-[420px] lg:max-w-[620px]">
      <BidonScene sizes="(min-width: 1024px) 620px, (min-width: 640px) 420px, 300px" />
    </div>

    <div class="hero-texte reveal">
      {accueil.texte && <p class="max-w-xl text-base leading-relaxed text-attenue sm:text-lg">{accueil.texte}</p>}

      <!-- CTA empilés en pleine largeur sur mobile (toucher facile) -->
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="/produits" class="btn-primary w-full sm:w-auto">Voir le catalogue</a>
        <a href="/contact" class="btn-outline w-full sm:w-auto">Demander un devis</a>
        {
          lienWhatsApp && (
            <a href={lienWhatsApp} target="_blank" rel="noopener noreferrer" class="btn-outline w-full sm:w-auto">
              WhatsApp
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grille {
    display: grid;
    grid-template-areas: 'titre' 'bidon' 'texte';
    gap: 1.25rem;
  }
  .hero-titre { grid-area: titre; }
  .hero-bidon { grid-area: bidon; }
  .hero-texte { grid-area: texte; }

  @media (min-width: 64rem) {
    .hero-grille {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'titre bidon' 'texte bidon';
      column-gap: 4rem;
      row-gap: 1.25rem;
    }
    .hero-titre { align-self: end; }
    .hero-texte { align-self: start; }
    .hero-bidon { align-self: center; }
  }
</style>
