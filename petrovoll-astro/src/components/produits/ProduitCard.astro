---
/**
 * ProduitCard.astro — vignette du catalogue (HTML pur, zéro JS).
 * Toute la carte est un seul lien (grande cible tactile). Les attributs
 * data-* servent au filtre du catalogue (FiltreCatalogue.astro).
 */
import PhotoProduit from '@/components/produits/PhotoProduit.astro'
import type { Produit } from '@/lib/contenu'
import { formaterPrix } from '@/lib/format'

interface Props {
  produit: Produit
}
const { produit } = Astro.props
const { nom, photos, prix, conditionnement, disponible, marque, secteur } = produit.data
const texteRecherche = [nom, conditionnement, marque].filter(Boolean).join(' ').toLowerCase()
---

<li data-produit data-secteur={secteur ?? ''} data-disponible={String(disponible)} data-texte={texteRecherche}>
  <a
    href={`/produits/${produit.id}`}
    class="group flex h-full flex-col overflow-hidden rounded-md border border-bordure bg-surface transition-colors hover:border-accent/50"
  >
    <div class="relative aspect-[4/3] overflow-hidden bg-fond">
      <PhotoProduit
        photo={photos[0]}
        alt=""
        {secteur}
        {marque}
        largeurs={[320, 480, 640]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="h-full w-full transition-transform duration-300 group-hover:scale-105"
      />
      {
        !disponible && (
          <span class="absolute left-3 top-3 rounded bg-fond/85 px-2 py-1 text-xs font-semibold text-vif">
            Sur commande
          </span>
        )
      }
    </div>

    <div class="flex flex-1 flex-col gap-1 p-4">
      <h3 class="text-base font-semibold leading-snug group-hover:text-vif">{nom}</h3>
      {conditionnement && <p class="text-sm text-attenue">{conditionnement}</p>}
      <p class="mt-auto pt-2 font-display text-xl tracking-wide text-vif">{formaterPrix(prix)}</p>
    </div>
  </a>
</li>
