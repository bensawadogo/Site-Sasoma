---
/**
 * ProduitCard.astro — vignette catalogue (100 % HTML, zero JS).
 * Mobile-first : image 4:3, touch target = toute la card (<a> unique).
 * Images : width/height fixes (pas de CLS), lazy natif, WebP via <Image />.
 *
 * TODO [images] : remplacer <img> par <Image> d'Astro (formats avif/webp,
 * widths 400/600/800) des que les visuels sont dans src/assets/.
 * TODO [produit] : badge "Produit phare" si estProduitPhare, pastille
 * disponibilite (vert/dispo, ambre/sur commande).
 */
import { resolveImageSource } from '@/lib/utils'

interface Visuel { image?: string | null; urlCloudinary?: string | null; alt: string }
interface Props {
  slug: string
  titre: string
  marque?: string
  reference?: string
  secteur: string
  disponible?: boolean
  estProduitPhare?: boolean
  visuel?: Visuel | null
}

const { slug, titre, marque, reference, secteur, disponible = true, estProduitPhare = false, visuel } = Astro.props
const src = resolveImageSource(visuel ?? undefined) ?? '/images/bidon-fallback.png'
const alt = visuel?.alt ?? `Visuel ${titre}`
---

<article class="group overflow-hidden rounded-md border border-border bg-surface transition-colors hover:border-accent/50">
  <a href={`/produits/${slug}`} class="block" aria-label={`Voir ${titre}`}>
    <div class="relative aspect-[4/3] overflow-hidden bg-primary">
      <img
        src={src}
        alt={alt}
        width="600"
        height="450"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
      {
        estProduitPhare && (
          <span class="absolute left-3 top-3 rounded bg-accent px-2 py-1 text-xs font-bold uppercase tracking-wide text-white">
            Phare
          </span>
        )
      }
    </div>

    <div class="p-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-gold">{marque ?? secteur}</p>
      <h3 class="mt-1 line-clamp-2 font-display text-xl leading-tight tracking-wide group-hover:text-gold">
        {titre}
      </h3>
      {
        reference && (
          <p class="mt-1 text-xs text-muted">
            Réf. {reference}
          </p>
        )
      }
      <p class={`mt-3 inline-flex items-center gap-1.5 text-xs font-medium ${disponible ? 'text-green-400' : 'text-gold'}`}>
        <span class={`h-1.5 w-1.5 rounded-full ${disponible ? 'bg-green-400' : 'bg-gold'}`} aria-hidden="true" />
        {disponible ? 'Disponible' : 'Sur commande'}
      </p>
    </div>
  </a>
</article>
