---
/**
 * ProduitGrid.astro — grille de produits (1 → 2 → 3 colonnes).
 * Le message « aucun produit » sert aussi au filtre du catalogue, qui
 * l'affiche quand aucun résultat ne correspond.
 */
import ProduitCard from '@/components/produits/ProduitCard.astro'
import type { Produit } from '@/lib/contenu'

interface Props {
  produits: Produit[]
}
const { produits } = Astro.props
---

<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" data-grille-produits>
  {produits.map((produit) => <ProduitCard produit={produit} />)}
</ul>
<p
  role="status"
  class="rounded-md border border-dashed border-bordure p-8 text-center text-sm text-attenue"
  data-aucun-produit
  hidden={produits.length > 0}
>
  Aucun produit ne correspond. Essayez un autre mot ou contactez-nous.
</p>
