---
/**
 * ProduitGrid.astro — grille catalogue (HTML pur, zero JS).
 * Mobile-first : 1 col -> 2 col des sm: -> 3 col des lg:.
 * Le filtrage interactif vit dans FiltreIsland.tsx (client:load).
 *
 * TODO [produit] : etats vide/erreur accessibles (role="status").
 */
import ProduitCard from '@/components/produits/ProduitCard.astro'

interface Item {
  slug: string; titre: string; marque?: string; reference?: string
  secteur: string; disponible?: boolean; estProduitPhare?: boolean
  visuel?: { image?: string | null; urlCloudinary?: string | null; alt: string } | null
}
interface Props { produits: Item[] }
const { produits } = Astro.props
---

{
  produits.length > 0 ? (
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {produits.map((p) => (
        <li>
          <ProduitCard {...p} />
        </li>
      ))}
    </ul>
  ) : (
    <p role="status" class="rounded-md border border-dashed border-border p-8 text-center text-sm text-muted">
      Aucun produit dans cette selection. Modifiez les filtres ou contactez-nous.
    </p>
  )
}
