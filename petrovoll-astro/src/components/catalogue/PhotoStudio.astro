---
/**
 * Photo produit sur fond studio (dégradé radial doux + ombre de contact).
 * Sans photo : emplacement sobre (silhouette de bidon), jamais d'image cassée.
 */
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  photo?: ImageMetadata
  alt: string
  widths: number[]
  sizes: string
  prioritaire?: boolean
  class?: string
  /** Largeur de l'image dans le cadre. */
  imgClass?: string
}
const { photo, alt, widths, sizes, prioritaire = false, class: classe = '', imgClass = 'w-[92%] h-auto' } = Astro.props
---

<div class:list={['studio', classe]}>
  {
    photo ? (
      <Picture
        src={photo}
        alt={alt}
        widths={widths}
        sizes={sizes}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        quality={78}
        loading={prioritaire ? 'eager' : 'lazy'}
        fetchpriority={prioritaire ? 'high' : 'auto'}
        decoding={prioritaire ? 'sync' : 'async'}
        class:list={['photo-bidon aspect-square object-contain', imgClass]}
      />
    ) : (
      <div class="studio-vide flex w-full flex-col items-center gap-3" role="img" aria-label="Photo à venir">
        <svg viewBox="0 0 64 80" class="h-[46%] w-auto" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 8h14l4 6v6l7 6v46a4 4 0 0 1-4 4H16a4 4 0 0 1-4-4V26l7-6v-8z" />
          <path d="M22 8v6h18M26 44h18M26 54h18" />
        </svg>
        <span class="text-[11px] font-semibold uppercase tracking-[0.14em]">Photo à venir</span>
      </div>
    )
  }
</div>
