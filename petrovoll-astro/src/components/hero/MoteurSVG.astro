---
/**
 * MoteurSVG.astro — moteur 4 cylindres en ligne, vue en coupe de face
 * (temps T3 du hero, décision D3 de TODO.md). Illustration vectorielle animée
 * par src/scripts/moteur-svg.ts : animerMoteur(svg, etat).
 *
 * Repère local fixe : viewBox 0 0 1000 1000, fond transparent.
 *  - OUVERTURE DE REMPLISSAGE (arrivée du filet d'huile) : x = 500, y = 120
 *    → fractions du viewBox : (0.5 ; 0.12). Bouchon ouvert
 *    sur le couvre-culasse, centre de l'embouchure du goulot.
 *  - Encombrement : x 115 → 885, y 118 (goulot) → 928 (carter).
 *  - Cylindres en x = 230, 410, 590, 770 ; vilebrequin en y = 641 ; arbre à cames en y = 240.
 *
 * Crochets lus par le script (ne pas renommer) : data-exterieur, data-came,
 * data-soupape, data-ressort, data-piston, data-bielle, data-manivelle,
 * data-film (+ data-mode, data-o, data-de, data-a, data-max), data-goutte.
 * Les identifiants (mt…) sont fixes : un seul moteur par page.
 * Fichier généré depuis la géométrie de moteur-svg.ts (test de cohérence
 * dans moteur-svg.test.ts) : modifier les deux ensemble.
 */
interface Props {
  class?: string
}
const { class: classe } = Astro.props
