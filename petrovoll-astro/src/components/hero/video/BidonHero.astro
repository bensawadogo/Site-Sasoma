---
/**
 * BidonHero.astro — le bidon du hero vidéo (photo P1 découpée : corps + bouchon),
 * commun aux heros mobile et desktop. Le script (hero-video/noyau.ts) le place,
 * fait monter l'huile, sauter le bouchon et le fait basculer. La surface de l'huile
 * reste horizontale quand le bidon penche (contre-rotation autour du pivot).
 */
import bouchon from '@/assets/hero/bidon/bouchon.webp'
import corps from '@/assets/hero/bidon/corps.webp'
import geometrie from '@/assets/hero/bidon/geometrie.json'

const g = geometrie
const pc = (v: number) => `${+(v * 100).toFixed(2)}%`
---

<div
  class="bidon"
  data-bidon-hero
  data-aspect={g.cadre.l / g.cadre.h}
  aria-hidden="true"
  style={`--aspect:${g.cadre.l / g.cadre.h};--masque:url(${corps.src});--goulot-x:${pc(g.spout.x)};--goulot-y:${pc(g.spout.y)};--pivot-x:${pc(g.bottlePivot.x)};--pivot-y:${pc(g.bottlePivot.y)};--ouverture:${pc(g.ouverture.l)}`}
>
  <img class="corps" src={corps.src} width={corps.width} height={corps.height} alt="" decoding="async" />
  <div class="huile"><div class="niveau" data-niveau></div></div>
  <div class="reflets">
    <div class="menisque" data-menisque></div>
    <div class="lumiere" data-lumiere></div>
  </div>
  <span class="ouverture"></span>
  <img
    class="bouchon"
    data-bouchon
    src={bouchon.src}
    width={bouchon.width}
    height={bouchon.height}
    alt=""
    decoding="async"
    style={`left:${pc(g.bouchon.x)};top:${pc(g.bouchon.y)};width:${pc(g.bouchon.l)}`}
  />
</div>

<style>
  /* Position sans JS : variables --bidon-* du hero parent ; le script la remplace. */
  .bidon {
    position: absolute;
    left: var(--bidon-x);
    top: var(--bidon-y);
    height: var(--bidon-h);
    aspect-ratio: var(--aspect);
    will-change: transform, opacity;
  }
  .corps {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Pas de will-change sur .niveau, .lumiere, .menisque : promus, ces grands calques
     (jusqu'à 400 % du bidon, soit plusieurs Mo de mémoire graphique chacun) pèsent sur
     un téléphone de 2 Go ; ils restent peints dans le calque du bidon.
     L'huile monte dans la silhouette exacte du bidon (effet rayons X) : teinte ambre en
     « multiply », comme de l'huile vue à travers le plastique ; l'étiquette reste lisible. */
  .huile,
  .reflets {
    position: absolute;
    inset: 0;
    overflow: hidden;
    -webkit-mask: var(--masque) center / 100% 100% no-repeat;
    mask: var(--masque) center / 100% 100% no-repeat;
    pointer-events: none;
  }
  .huile {
    mix-blend-mode: multiply;
    opacity: 0.3;
  }
  /* Ligne claire de la surface (ménisque), mêmes transformations que le niveau. */
  .menisque {
    position: absolute;
    left: var(--pivot-x);
    top: var(--pivot-y);
    width: 400%;
    height: 2px;
    margin: -1px 0 0 -200%;
    background: rgb(246 210 122 / 0.7);
    transform-origin: 50% 1px;
    transform: translate3d(0, 100vh, 0);
  }
  /* Lumière du studio, fixée au monde (contre-rotation) : haut éclairé, bas dans l'ombre. */
  .lumiere {
    position: absolute;
    left: var(--pivot-x);
    top: var(--pivot-y);
    width: 300%;
    height: 300%;
    margin: -150% 0 0 -150%;
    background: linear-gradient(to bottom, rgb(255 250 235 / 0.1) 30%, transparent 48%, transparent 52%, rgb(0 0 0 / 0.18) 70%);
    transform-origin: 50% 50%;
  }
  /* Grand rectangle dont le bord haut est la surface de l'huile. Son origine est le
     pivot du bidon : le script le contre-tourne (surface horizontale) et le descend
     (niveau), en px, dans le repère de l'écran. Sans script : bidon vide. */
  .niveau {
    position: absolute;
    left: var(--pivot-x);
    top: var(--pivot-y);
    width: 400%;
    height: 400%;
    margin-left: -200%;
    background: linear-gradient(to bottom, rgb(200 144 26 / 0) 0, #c8901a 7px);
    transform-origin: 50% 0;
    transform: translate3d(0, 100vh, 0);
  }
  .ouverture {
    position: absolute;
    left: var(--goulot-x);
    top: var(--goulot-y);
    width: var(--ouverture);
    aspect-ratio: 3;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, #000 55%, #3a3a3a 85%, #8a8a8a);
  }
  .bouchon {
    position: absolute;
    height: auto;
    will-change: transform, opacity;
  }
</style>
