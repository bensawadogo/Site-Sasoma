---
/**
 * HeroDesktop.astro — hero vidéo pour ordinateur (≥ 900 px).
 * Séquence 1920×1080 (moteur en coupe calé à gauche), bidon à droite qui se penche vers
 * la gauche et verse dans l'orifice puis part ; étiquettes des pièces à droite du moteur. Réglages : HERO_DESKTOP (src/hero-video.config.ts) ; animation :
 * src/scripts/hero-video/desktop.ts.
 */
import BidonHero from '@/components/hero/video/BidonHero.astro'
import HeroReperes from '@/components/hero/video/HeroReperes.astro'
import HeroTextes from '@/components/hero/video/HeroTextes.astro'
import { HERO_DESKTOP as R } from '@/hero-video.config'

const pc = (v: number) => `${+(v * 100).toFixed(2)}%`
const affiche = `${R.sequence.dossier}/affiche.webp?v=${R.sequence.version}`
const variables = [
  `--hauteur:${R.hauteur}`,
  `--affiche:url(${affiche})`,
  `--decor-penombre:url(${R.sequence.dossier}/decor-penombre.webp?v=${R.sequence.version})`,
  `--decor-allume:url(${R.sequence.dossier}/decor-allume.webp?v=${R.sequence.version})`,
  ...Object.entries(R.zones).flatMap(([nom, z]) => [
    `--${nom}-x:${pc(z.x)}`,
    `--${nom}-y:${pc(z.y)}`,
    `--${nom}-l:${pc(z.l)}`,
    `--${nom}-h:${pc(z.h)}`,
  ]),
].join(';')
---

<section class="hero-desktop zone-sombre relative -mt-16 lg:-mt-20" style={variables} data-hero-desktop aria-labelledby="hero-titre-desktop">
  <div class="scene" data-scene>
    {
      R.sequence.decor && (
        <div class="decor" data-decor aria-hidden="true">
          <div class="decor-allume" data-decor-allume />
        </div>
      )
    }
    <canvas class="sequence" data-sequence aria-hidden="true"></canvas>
    <div class="couche voile" aria-hidden="true"></div>
    <canvas class="couche" data-filet aria-hidden="true"></canvas>
    <HeroReperes mode="colonne" cote={R.etiquettes} />
    <BidonHero />
    <HeroTextes idTitre="hero-titre-desktop" />
  </div>
</section>

<style>
  .hero-desktop {
    height: 100svh; /* sans JS : un seul écran, l'affiche du moteur */
    background: #000;
    --taille-titre: clamp(2.5rem, 3.8vw, 4.25rem);
    --taille-etape: clamp(1.75rem, 2.6vw, 2.75rem);
    --actions-direction: row;
  }
  .hero-desktop[data-pret] {
    height: var(--hauteur);
  }
  /* En dessous de 900 px (RUPTURE_DESKTOP), c'est le hero mobile. */
  @media (max-width: 899px) {
    .hero-desktop {
      display: none;
    }
  }
  .scene {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    contain: layout paint;
    background: #000;
  }
  /* Séquence plein écran, image réduite (zoom 0,72) posée en bas à gauche. Affiche = 1re image,
     visible avant le script et sans JS ; une image de fond d'un élément masqué (hero
     mobile sur ordinateur) n'est pas téléchargée. */
  .sequence {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: var(--affiche) 0% 100% / auto 72% no-repeat; /* proche du cadrage de HERO_DESKTOP */
    pointer-events: none;
  }
  /* Garage : même échelle que la séquence, champ double, centré sur elle (placé exactement
     par le script ; sans JS, calé comme l'affiche). Le garage s'éclaire pendant le versement. */
  .decor {
    position: absolute;
    /* affiche : 72 % de la hauteur, en bas à gauche (image 1344×768) */
    left: -63svh;
    top: -8svh;
    width: 252svh;
    height: 144svh;
    background: var(--decor-penombre) center / 100% 100% no-repeat;
    /* bords fondus dans le noir de la scène (écran très large, haut du téléphone) */
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent), linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    mask-composite: intersect;
    pointer-events: none;
  }
  .decor-allume {
    position: absolute;
    inset: 0;
    background: var(--decor-allume) center / 100% 100% no-repeat;
    opacity: 0;
  }
  .couche {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .voile {
    /* Bas légèrement assombri : lisibilité des textes ; le moteur reste net. Vignette du garage. */
    background:
      linear-gradient(to bottom, transparent 70%, rgb(0 0 0 / 0.6) 100%),
      radial-gradient(ellipse 80% 75% at 40% 55%, transparent 55%, rgb(0 0 0 / 0.45) 100%);
  }
  /* Les étapes du moteur sont dans les étiquettes, à droite du moteur. */
  .hero-desktop :global([data-etape]) {
    display: none;
  }
</style>

<script>
  import { demarrerHeroDesktop } from '@/scripts/hero-video/desktop'

  document.querySelectorAll<HTMLElement>('[data-hero-desktop]').forEach(demarrerHeroDesktop)
</script>
