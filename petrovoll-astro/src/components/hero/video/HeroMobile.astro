---
/**
 * HeroMobile.astro — hero vidéo pour téléphone (< 900 px).
 * Séquence 880×614 sur toute la largeur (moteur en coupe), bidon en haut à gauche qui se
 * penche et verse dans l'orifice, pastilles sur les pièces, textes en bas. Réglages : HERO_MOBILE (src/hero-video.config.ts) ; animation :
 * src/scripts/hero-video/mobile.ts.
 */
import BidonHero from '@/components/hero/video/BidonHero.astro'
import HeroReperes from '@/components/hero/video/HeroReperes.astro'
import HeroTextes from '@/components/hero/video/HeroTextes.astro'
import { HERO_MOBILE as R } from '@/hero-video.config'

const pc = (v: number) => `${+(v * 100).toFixed(2)}%`
const affiche = `${R.sequence.dossier}/000.webp?v=${R.sequence.version}`
const variables = [
  `--hauteur:${R.hauteur}`,
  `--affiche:url(${affiche})`,
  ...Object.entries(R.zones).flatMap(([nom, z]) => [
    `--${nom}-x:${pc(z.x)}`,
    `--${nom}-y:${pc(z.y)}`,
    `--${nom}-l:${pc(z.l)}`,
    `--${nom}-h:${pc(z.h)}`,
  ]),
].join(';')
---

<section class="hero-mobile zone-sombre relative -mt-16" style={variables} data-hero-mobile aria-labelledby="hero-titre-mobile">
  <div class="scene" data-scene>
    <canvas class="sequence" data-sequence aria-hidden="true"></canvas>
    <div class="couche voile" aria-hidden="true"></div>
    <canvas class="couche" data-filet aria-hidden="true"></canvas>
    <HeroReperes mode="pastille" />
    <BidonHero />
    <HeroTextes idTitre="hero-titre-mobile" />
  </div>
</section>

<style>
  .hero-mobile {
    height: 100svh; /* sans JS : un seul écran, l'affiche du moteur */
    background: #000;
    --taille-titre: clamp(2.25rem, 11vw, 3.75rem);
    --taille-etape: clamp(1.75rem, 8vw, 2.75rem);
  }
  .hero-mobile[data-pret] {
    height: var(--hauteur);
  }
  /* Le hero desktop prend le relais au-delà de 900 px (RUPTURE_DESKTOP). */
  @media (min-width: 900px) {
    .hero-mobile {
      display: none;
    }
  }
  .scene {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    contain: layout paint;
    background: #000;
  }
  /* Moteur (zone « moteur » de HERO_MOBILE) ; le fond de l'image est déjà noir pur.
     Affiche = 1re image, visible avant le script et sans JS ; une image de fond
     d'un élément masqué (hero desktop sur téléphone) n'est pas téléchargée. */
  .sequence {
    position: absolute;
    left: var(--moteur-x);
    top: var(--moteur-y);
    width: var(--moteur-l);
    height: var(--moteur-h);
    background: #000 var(--affiche) center / cover no-repeat;
    pointer-events: none;
  }
  .couche {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .voile {
    background: linear-gradient(to bottom, transparent 62%, rgb(0 0 0 / 0.85) 80%, #000 100%);
  }
</style>

<script>
  import { demarrerHeroMobile } from '@/scripts/hero-video/mobile'

  document.querySelectorAll<HTMLElement>('[data-hero-mobile]').forEach(demarrerHeroMobile)
</script>
