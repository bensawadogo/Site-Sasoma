---
/**
 * HeroMobile.astro — hero vidéo pour téléphone (< 900 px).
 * Séquence 880×614 sur toute la largeur (moteur en coupe), bidon en haut à gauche qui se
 * penche et verse dans l'orifice, pastilles sur les pièces, textes en bas. Réglages : HERO_MOBILE (src/hero-video.config.ts) ; animation :
 * src/scripts/hero-video/mobile.ts.
 */
import BidonHero from '@/components/hero/video/BidonHero.astro'
import HeroReperes from '@/components/hero/video/HeroReperes.astro'
import HeroTextes from '@/components/hero/video/HeroTextes.astro'
import FondRoute from '@/components/hero/video/FondRoute.astro'
import { FOND_ROUTE, HERO_MOBILE as R } from '@/hero-video.config'

const pc = (v: number) => `${+(v * 100).toFixed(2)}%`
const affiche = `${R.sequence.dossier}/affiche.webp?v=${R.sequence.version}`
const variables = [
  `--hauteur:${R.hauteur}`,
  `--affiche:url(${affiche})`,
  `--affiche-moteur:url(${R.sequence.dossier}/affiche-moteur.webp?v=${R.sequence.version})`,
  `--decor-penombre:url(${R.sequence.dossier}/decor-penombre.webp?v=${R.sequence.version})`,
  `--decor-allume:url(${R.sequence.dossier}/decor-allume.webp?v=${R.sequence.version})`,
  ...Object.entries(R.zones).flatMap(([nom, z]) => [
    `--${nom}-x:${pc(z.x)}`,
    `--${nom}-y:${pc(z.y)}`,
    `--${nom}-l:${pc(z.l)}`,
    `--${nom}-h:${pc(z.h)}`,
  ]),
].join(';')
---

<section class="hero-mobile zone-sombre relative -mt-16" style={variables} data-hero-mobile data-route={FOND_ROUTE.actif ? "" : undefined} aria-labelledby="hero-titre-mobile">
  <div class="scene" data-scene>
    {FOND_ROUTE.actif && <FondRoute format="mobile" />}
    {FOND_ROUTE.actif && <div class="ombre-moteur" data-ombre-moteur aria-hidden="true" />}
    {
      R.sequence.decor && (
        <div class="decor" data-decor aria-hidden="true">
          <div class="decor-allume" data-decor-allume />
        </div>
      )
    }
    <canvas class="sequence flotte" data-sequence aria-hidden="true"></canvas>
    <div class="couche voile" aria-hidden="true"></div>
    <canvas class="couche flotte" data-filet aria-hidden="true"></canvas>
    <HeroReperes mode="pastille" cote={R.etiquettes} />
    <BidonHero />
    <HeroTextes idTitre="hero-titre-mobile" />
  </div>
</section>

<style>
  .hero-mobile {
    height: 100svh; /* sans JS : un seul écran, l'affiche du moteur */
    background: #000;
    --taille-titre: clamp(2.25rem, 11vw, 3.75rem);
    --taille-etape: clamp(1.75rem, 8vw, 2.75rem);
  }
  .hero-mobile[data-pret] {
    height: var(--hauteur);
  }
  /* Le hero desktop prend le relais au-delà de 900 px (RUPTURE_DESKTOP). */
  @media (min-width: 900px) {
    .hero-mobile {
      display: none;
    }
  }
  .scene {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    contain: layout paint;
    background: #000;
  }
  /* Moteur (zone « moteur » de HERO_MOBILE), dans le garage.
     Affiche = 1re image, visible avant le script et sans JS ; une image de fond
     d'un élément masqué (hero desktop sur téléphone) n'est pas téléchargée. */
  .sequence {
    position: absolute;
    left: var(--moteur-x);
    top: var(--moteur-y);
    width: var(--moteur-l);
    height: var(--moteur-h);
    background: var(--affiche) center / cover no-repeat;
    pointer-events: none;
  }
  /* Garage : même échelle que la séquence, champ double, centré sur elle (placé exactement
     par le script ; sans JS, calé comme l'affiche). Le garage s'éclaire pendant le versement. */
  .decor {
    position: absolute;
    /* zone moteur agrandie de moitié de chaque côté : « cover » y tombe à la même échelle */
    left: calc(var(--moteur-x) - var(--moteur-l) / 2);
    top: calc(var(--moteur-y) - var(--moteur-h) / 2);
    width: calc(var(--moteur-l) * 2);
    height: calc(var(--moteur-h) * 2);
    background: var(--decor-penombre) center / 100% 100% no-repeat;
    /* bords fondus dans le noir de la scène (écran très large, haut du téléphone) */
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent), linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    mask-composite: intersect;
    pointer-events: none;
  }
  .decor-allume {
    position: absolute;
    inset: 0;
    background: var(--decor-allume) center / 100% 100% no-repeat;
    opacity: 0;
  }
  .couche {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .voile {
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.55) 0%, transparent 30%, transparent 62%, rgb(0 0 0 / 0.85) 80%, #000 100%),
      radial-gradient(ellipse 90% 60% at 50% 53%, transparent 50%, rgb(0 0 0 / 0.4) 100%);
  }
  /* Fond route (FOND_ROUTE) : le garage est retiré, seul le moteur (affiche détourée par
     masque.webp) est posé sur la vidéo de la route. */
  [data-route] .decor {
    background: none;
    mask-image: none;
  }
  [data-route] .decor-allume {
    display: none;
  }
  [data-route] .sequence {
    background-image: var(--affiche-moteur);
  }
</style>

<script>
  import { demarrerHeroMobile } from '@/scripts/hero-video/mobile'

  document.querySelectorAll<HTMLElement>('[data-hero-mobile]').forEach(demarrerHeroMobile)
</script>
