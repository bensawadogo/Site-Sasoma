---
/**
 * HeroTextes.astro — textes du hero vidéo (ouverture, étapes, écran de fin avec
 * produits et bouton), communs aux heros mobile et desktop. Chaque hero les
 * place avec ses propres variables CSS (--textes-*, --fin-*).
 */
import { Image } from 'astro:assets'

// Mêmes photos et même studio clair que les cartes du catalogue (Ben, 09/10 : « pas le fond bleu »).
import photoMotpro from '@/assets/produits/motpro-4t.webp'
import photoStark from '@/assets/produits/stark-semi-synthetic.webp'
import { HERO } from '@/hero.config'
import { APPARITIONS_REPERES } from '@/hero-video.config'
import { getParametres } from '@/lib/contenu'

interface Props {
  /** id du h1 (un par hero : le hero masqué par la media query est hors de l'arbre d'accessibilité). */
  idTitre: string
}
const { idTitre } = Astro.props

const parametres = await getParametres()
const avecSociete = (texte: string) => texte.replaceAll('{societe}', parametres.nomSociete)
const lienWhatsApp = parametres.whatsapp(avecSociete(HERO.messageWhatsApp))
const { textes } = HERO
const VIGNETTES = [
  { src: photoStark, fond: 'studio' },
  { src: photoMotpro, fond: 'studio' },
] as const

const plage = (id: string) => HERO.temps.find((t) => t.id === id)!
const t3 = plage('t3')
const dansT3 = (f: number) => t3.debut + f * (t3.fin - t3.debut)
// Étapes du moteur : chacune arrive avec l'étiquette de sa pièce, quand l'huile l'atteint
// (la dernière jusqu'à la fin de t3). Sur desktop, les étiquettes (HeroReperes) les remplacent.
const arrivee = (i: number) => dansT3(APPARITIONS_REPERES[i])
const blocs = [
  { ...plage('t1'), ...textes.t1, etape: false },
  // Le texte du versement reste jusqu'à l'arrivée de la première pièce (pas d'écran vide).
  { ...plage('t2'), fin: arrivee(0), ...textes.t2, etape: false },
  ...textes.t3.map((t, i) => ({
    debut: arrivee(i),
    fin: i === textes.t3.length - 1 ? t3.fin : arrivee(i + 1),
    ...t,
    etape: true,
  })),
]
---

<div class="bloc textes" data-bloc data-actif data-debut="0" data-fin={plage('ouverture').fin}>
  <p class="surtitre">{textes.ouverture.surtitre}</p>
  <h1 id={idTitre} class="titre">{textes.ouverture.titre}</h1>
  <p class="indice" aria-hidden="true">{textes.ouverture.indice} <span>↓</span></p>
</div>

{
  blocs.map((b) => (
    <div class="bloc textes" data-bloc data-etape={b.etape || undefined} data-debut={b.debut} data-fin={b.fin} inert>
      <h2 class="etape">{b.titre}</h2>
      <p class="texte">{b.texte}</p>
    </div>
  ))
}

<div class="bloc fin" data-bloc data-debut={plage('fin').debut} data-fin="1" inert>
  <h2 class="etape">{textes.fin.titre}</h2>
  <p class="texte">{avecSociete(textes.fin.texte)}</p>
  <ul class="produits">
    {
      HERO.produitsFin.map((p, i) => (
        <li class="produit">
          <span class:list={['visuel', `visuel--${VIGNETTES[i].fond}`]}>
            <Image src={VIGNETTES[i].src} alt="" widths={[160, 240, 320]} sizes="120px" format="webp" quality={82} loading="lazy" />
          </span>
          <span class="libelle">{p.libelle}</span>
          <span class="nom">{p.nom}</span>
        </li>
      ))
    }
  </ul>
  <div class="actions">
    {
      lienWhatsApp ? (
        <a href={lienWhatsApp} target="_blank" rel="noopener noreferrer" class="btn-primary cta">
          {textes.fin.cta}
        </a>
      ) : parametres.lienTelephone ? (
        <a href={parametres.lienTelephone} class="btn-primary cta">
          Appeler {parametres.telephone}
        </a>
      ) : (
        <a href="/contact" class="btn-primary cta">
          Nous contacter
        </a>
      )
    }
    <a href={textes.fin.lienSecondaire} class="btn-outline">{textes.fin.ctaSecondaire}</a>
  </div>
</div>

<style>
  .bloc {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    will-change: opacity, transform;
  }
  .bloc[data-debut='0'] {
    opacity: 1;
  }
  .bloc[data-actif] {
    pointer-events: auto;
  }
  .textes {
    left: var(--textes-x);
    top: var(--textes-y);
    width: var(--textes-l);
    height: var(--textes-h);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .fin {
    left: var(--fin-x);
    top: var(--fin-y);
    width: var(--fin-l);
    height: var(--fin-h);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
  }
  .surtitre {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f0cc30;
  }
  .titre {
    margin-top: 0.4rem;
    font-size: var(--taille-titre);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .indice {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-attenue);
  }
  .etape {
    font-size: var(--taille-etape);
    line-height: 1;
    text-transform: uppercase;
  }
  .texte {
    margin-top: 0.4rem;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-attenue);
    max-width: 34rem;
  }
  .produits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  /* Carte du catalogue en réduction : studio clair en haut, fiche blanche en bas. */
  .produit {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 0.875rem;
    background: #fff;
    color: #0b1b33;
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.6);
  }
  .visuel {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    width: 100%;
    height: 7.5rem;
  }
  /* Petit studio photo : fond dégradé, lumière douce derrière le produit, ombre au sol. */
  .visuel--studio {
    background: radial-gradient(70% 60% at 50% 44%, #ffffff 0%, #f1f5f9 62%, #e6edf4 100%);
  }
  .visuel--studio::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 9%;
    width: 46%;
    height: 7%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(11 27 51 / 0.28), transparent);
  }
  .visuel :global(img) {
    height: 100%;
    width: auto;
    max-width: 100%;
    position: relative;
    z-index: 1;
    object-fit: contain; /* jamais rogné */
  }
  .libelle {
    padding: 0.6rem 0.75rem 0;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c2410c;
  }
  .nom {
    padding: 0.15rem 0.75rem 0.7rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
    color: #0b1b33;
  }
  .actions {
    display: flex;
    flex-direction: var(--actions-direction, column);
    gap: 0.6rem;
  }
  .cta {
    background: #c7161c; /* rouge Petrovöll (research/palette.json) */
  }
</style>
