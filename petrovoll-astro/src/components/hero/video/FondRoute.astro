---
/**
 * FondRoute.astro — fond du hero : la route dont les nuages bougent (FOND_ROUTE,
 * src/hero-video.config.ts). L'affiche (première image de la vidéo) est en fond CSS : visible
 * sans JS et au niveau « faible » ; la vidéo est choisie et lancée par fond-route.ts.
 */
import { FOND_ROUTE } from '@/hero-video.config'

interface Props {
  format: 'desktop' | 'mobile'
}
const { format } = Astro.props
const affiche = `${FOND_ROUTE.dossier}/${format === 'desktop' ? 'route-affiche' : 'route-affiche-tel'}.webp?v=${FOND_ROUTE.version}`
---

<div class="fond-route" style={`--affiche-route:url(${affiche})`} aria-hidden="true">
  <video data-fond-route data-format={format} muted loop playsinline disablepictureinpicture preload="none"></video>
</div>

<style>
  .fond-route {
    position: absolute;
    inset: 0;
    background: #6f8fae var(--affiche-route) center / cover no-repeat;
    pointer-events: none;
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s;
  }
  video:global(.pret) {
    opacity: 1;
  }
</style>

<script>
  import { demarrerFondRoute } from '@/scripts/hero-video/fond-route'

  document.querySelectorAll<HTMLVideoElement>('[data-fond-route]').forEach(demarrerFondRoute)
</script>
