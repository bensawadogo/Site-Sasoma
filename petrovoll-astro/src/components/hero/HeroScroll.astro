---
/**
 * HeroScroll.astro — hero au scroll (BRIEF-MAITRE.md §8).
 *
 * Réglages et textes : src/hero.config.ts (volontairement HORS de l'admin).
 * Animation : src/scripts/hero-scroll.ts (un seul écouteur de scroll passif,
 * rendu dans requestAnimationFrame, uniquement opacity/transform).
 *
 * Sans JavaScript : un écran fixe avec le titre, le bidon et le moteur (100svh).
 * Avec JavaScript : la scène reste collée pendant 250svh (300svh sur desktop).
 *
 * Bidon : photo P1 découpée en corps + bouchon (npm run hero:bidon). L'huile
 * qui monte est un dégradé masqué par la silhouette du corps (mask-image).
 * Moteur : illustration vectorielle animée (MoteurSVG, décision D3 de TODO.md).
 */
import { Image } from 'astro:assets'

import bouchon from '@/assets/hero/bidon/bouchon.webp'
import corps from '@/assets/hero/bidon/corps.webp'
import geometrie from '@/assets/hero/bidon/geometrie.json'
import vignetteStark from '@/assets/hero/bidon/vignette.webp'
import photoMotpro from '@/assets/hero/fin/motpro-4t.jpg'
import MoteurSVG from '@/components/hero/MoteurSVG.astro'
import moteurE1 from '@/assets/hero/moteur-ia/E1.webp'
import moteurE2 from '@/assets/hero/moteur-ia/E2.webp'
import moteurE3 from '@/assets/hero/moteur-ia/E3.webp'
import { HERO } from '@/hero.config'
import { getParametres } from '@/lib/contenu'

const parametres = await getParametres()
const avecSociete = (texte: string) => texte.replaceAll('{societe}', parametres.nomSociete)
const lienWhatsApp = parametres.whatsapp(avecSociete(HERO.messageWhatsApp))
const { textes } = HERO
const pc = (v: number) => `${+(v * 100).toFixed(2)}%`
const g = geometrie
// Visuels de l'écran de fin, dans l'ordre de HERO.produitsFin (voiture, moto).
const VIGNETTES = [
  { src: vignetteStark, fond: 'sombre' },
  { src: photoMotpro, fond: 'clair' }, // rendu officiel petrovoll.com (fond blanc)
] as const

// Plages d'affichage des textes : t3 est partagé en trois (cames, pistons, vilebrequin).
const plage = (id: string) => HERO.temps.find((t) => t.id === id)!
const t3 = plage('t3')
const tiers = (t3.fin - t3.debut) / 3
const blocs = [
  { ...plage('t1'), ...textes.t1 },
  { ...plage('t2'), ...textes.t2 },
  ...textes.t3.map((t, i) => ({ debut: t3.debut + i * tiers, fin: t3.debut + (i + 1) * tiers, ...t })),
]

// Zones de la config → variables CSS (--textes-mobile-x : 6% …).
const variables = [
  `--hauteur-mobile:${HERO.hauteur.mobile}`,
  `--hauteur-desktop:${HERO.hauteur.desktop}`,
  ...Object.entries(HERO.zones).flatMap(([format, zones]) =>
    Object.entries(zones).flatMap(([nom, z]) =>
      (['x', 'y', 'l', 'h'] as const).map((c) => `--${nom}-${format}-${c}:${+(z[c] * 100).toFixed(2)}%`),
    ),
  ),
].join(';')
---

<section
  class="hero zone-sombre relative -mt-16 lg:-mt-20"
  style={variables}
  data-hero
  data-palier="lite"
  aria-labelledby="hero-titre"
>
  <div class="hero-scene">
    <div class="hero-fond" aria-hidden="true"></div>
    <div class="hero-moteur" data-moteur-cadre>
      <MoteurSVG />
      {/* Aperçu ?moteur=ia : images chargées par le script seulement dans ce mode. */}
      <div class="hero-moteur-ia" data-moteur-ia hidden>
        {[moteurE1, moteurE2, moteurE3].map((img) => (
          <img data-src={img.src} width={img.width} height={img.height} alt="" decoding="async" />
        ))}
      </div>
    </div>
    <div class="hero-voile" aria-hidden="true"></div>
    <canvas class="hero-filet" data-filet aria-hidden="true"></canvas>

    <div
      class="hero-bidon"
      data-bidon-hero
      data-aspect={g.cadre.l / g.cadre.h}
      aria-hidden="true"
      style={`--aspect:${g.cadre.l / g.cadre.h};--masque:url(${corps.src});--goulot-x:${pc(g.spout.x)};--goulot-y:${pc(g.spout.y)};--ouverture:${pc(g.ouverture.l)}`}
    >
      {/* WebP seul : le masque de l'huile utilise le même fichier, déjà en cache. */}
      <img class="hero-bidon-corps" src={corps.src} width={corps.width} height={corps.height} alt="" decoding="async" />
      <div class="hero-bidon-huile"><div class="hero-bidon-niveau" data-niveau></div></div>
      <span class="hero-bidon-ouverture"></span>
      <img
        class="hero-bidon-bouchon"
        data-bouchon
        src={bouchon.src}
        width={bouchon.width}
        height={bouchon.height}
        alt=""
        decoding="async"
        style={`left:${pc(g.bouchon.x)};top:${pc(g.bouchon.y)};width:${pc(g.bouchon.l)}`}
      />
    </div>

    <div class="hero-bloc hero-textes" data-debut="0" data-fin={plage('ouverture').fin}>
      <p class="hero-surtitre">{textes.ouverture.surtitre}</p>
      <h1 id="hero-titre" class="hero-titre">{textes.ouverture.titre}</h1>
      <p class="hero-indice" aria-hidden="true">{textes.ouverture.indice} <span>↓</span></p>
    </div>

    {
      blocs.map((b) => (
        <div class="hero-bloc hero-textes" data-debut={b.debut} data-fin={b.fin}>
          <h2 class="hero-titre-etape">{b.titre}</h2>
          <p class="hero-texte">{b.texte}</p>
        </div>
      ))
    }

    <div class="hero-bloc hero-fin" data-debut={plage('fin').debut} data-fin="1" data-fin-bloc inert>
      <h2 class="hero-titre-etape">{textes.fin.titre}</h2>
      <p class="hero-texte">{avecSociete(textes.fin.texte)}</p>
      <ul class="hero-produits">
        {
          HERO.produitsFin.map((p, i) => (
            <li class="hero-produit">
              <span class:list={['hero-produit-visuel', `hero-produit-visuel--${VIGNETTES[i].fond}`]}>
                <Image src={VIGNETTES[i].src} alt="" height={176} format="webp" quality={80} loading="lazy" />
              </span>
              <span class="hero-produit-libelle">{p.libelle}</span>
              <span class="hero-produit-nom">{p.nom}</span>
            </li>
          ))
        }
      </ul>
      <div class="hero-actions">
        {
          lienWhatsApp ? (
            <a href={lienWhatsApp} target="_blank" rel="noopener noreferrer" class="btn-primary hero-cta">
              {textes.fin.cta}
            </a>
          ) : parametres.lienTelephone ? (
            <a href={parametres.lienTelephone} class="btn-primary hero-cta">
              Appeler {parametres.telephone}
            </a>
          ) : (
            <a href="/contact#devis" class="btn-primary hero-cta">
              Nous contacter
            </a>
          )
        }
        <a href={textes.fin.lienSecondaire} class="btn-outline">{textes.fin.ctaSecondaire}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    height: 100svh; /* sans JS : un seul écran */
    background: #000;
  }
  .hero[data-pret] {
    height: var(--hauteur-mobile);
  }
  .hero-scene {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    contain: layout paint;
  }
  .hero-fond,
  .hero-filet,
  .hero-voile {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Studio noir, lumière chaude venant de la gauche (§6.2). */
  .hero-fond {
    background: radial-gradient(ellipse 70% 55% at 22% 38%, rgb(255 190 110 / 0.14), transparent 70%), #000;
  }
  /* Position sans JS (zone de la config) ; le script la remplace par le carré
     exact du dessin, puis n'y écrit plus que transform (cadrages) et opacity. */
  .hero-moteur {
    position: absolute;
    left: var(--moteur-mobile-x);
    top: var(--moteur-mobile-y);
    width: var(--moteur-mobile-l);
    height: var(--moteur-mobile-h);
    transform-origin: 0 0;
    will-change: transform;
  }
  .hero-moteur :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Le fond des images IA n'est pas d'un noir pur : bords fondus dans le studio noir. */
  .hero-moteur-ia {
    position: absolute;
    inset: 0;
    -webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 48%, #000 62%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 60% at 50% 48%, #000 62%, transparent 100%);
  }
  .hero-moteur-ia img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    will-change: opacity;
  }
  .hero-moteur-ia img:first-child {
    opacity: 1;
  }
  /* Bas assombri pour la lisibilité des textes (§6.2). */
  .hero-voile {
    background: linear-gradient(to bottom, transparent 55%, rgb(0 0 0 / 0.85) 78%, #000 100%);
    pointer-events: none;
  }
  .hero-filet {
    pointer-events: none;
  }

  .hero-bidon {
    position: absolute;
    left: var(--bidon-mobile-x);
    top: var(--bidon-mobile-y);
    height: var(--bidon-mobile-h);
    aspect-ratio: var(--aspect);
    will-change: transform, opacity;
  }
  .hero-bidon-corps {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* L'huile monte à l'intérieur de la silhouette exacte du bidon (effet rayons X). */
  .hero-bidon-huile {
    position: absolute;
    inset: 0;
    overflow: hidden;
    -webkit-mask: var(--masque) center / 100% 100% no-repeat;
    mask: var(--masque) center / 100% 100% no-repeat;
    /* overlay : dore le plastique argenté sans masquer l'étiquette (comparé en capture
       avec multiply, soft-light, screen et normal). */
    mix-blend-mode: overlay;
    opacity: 0.65;
  }
  .hero-bidon-niveau {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, #fff4c2 0, #f0cc30 2%, #cc9c0c 100%);
    transform: translate3d(0, 100%, 0);
    will-change: transform;
  }
  /* Ouverture du goulot, cachée sous le bouchon jusqu'à ce qu'il saute. */
  .hero-bidon-ouverture {
    position: absolute;
    left: var(--goulot-x);
    top: var(--goulot-y);
    width: var(--ouverture);
    aspect-ratio: 3;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, #000 55%, #3a3a3a 85%, #8a8a8a);
  }
  .hero-bidon-bouchon {
    position: absolute;
    height: auto;
    will-change: transform, opacity;
  }

  .hero-bloc {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    will-change: opacity, transform;
  }
  .hero-bloc[data-debut='0'] {
    opacity: 1;
  }
  .hero-bloc[data-actif] {
    pointer-events: auto;
  }
  .hero-textes {
    left: var(--textes-mobile-x);
    top: var(--textes-mobile-y);
    width: var(--textes-mobile-l);
    height: var(--textes-mobile-h);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .hero-fin {
    left: var(--fin-mobile-x);
    top: var(--fin-mobile-y);
    width: var(--fin-mobile-l);
    height: var(--fin-mobile-h);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .hero-surtitre {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f0cc30;
  }
  .hero-titre {
    margin-top: 0.4rem;
    font-size: clamp(2.25rem, 11vw, 5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .hero-indice {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-attenue);
  }
  .hero-titre-etape {
    font-size: clamp(1.75rem, 8vw, 3.5rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .hero-texte {
    margin-top: 0.4rem;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-attenue);
    max-width: 34rem;
  }

  .hero-produits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .hero-produit {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.04);
  }
  .hero-produit-visuel {
    display: flex;
    justify-content: center;
    width: 100%;
    height: 5.5rem;
    border-radius: 0.375rem;
  }
  .hero-produit-visuel--clair {
    background: #fff;
  }
  .hero-produit-visuel :global(img) {
    height: 100%;
    width: auto;
    object-fit: contain;
  }
  .hero-produit-libelle {
    margin-top: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f0cc30;
  }
  .hero-produit-nom {
    font-weight: 700;
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .hero-cta {
    background: #c7161c; /* rouge Petrovöll (research/palette.json) */
  }

  /* 900px = HERO.pointDeRupture (une media query ne peut pas lire la config) */
  @media (min-width: 900px) {
    .hero[data-pret] {
      height: var(--hauteur-desktop);
    }
    .hero-moteur {
      left: var(--moteur-desktop-x);
      top: var(--moteur-desktop-y);
      width: var(--moteur-desktop-l);
      height: var(--moteur-desktop-h);
    }
    .hero-bidon {
      left: var(--bidon-desktop-x);
      top: var(--bidon-desktop-y);
      height: var(--bidon-desktop-h);
    }
    .hero-textes {
      left: var(--textes-desktop-x);
      top: var(--textes-desktop-y);
      width: var(--textes-desktop-l);
      height: var(--textes-desktop-h);
    }
    .hero-fin {
      left: var(--fin-desktop-x);
      top: var(--fin-desktop-y);
      width: var(--fin-desktop-l);
      height: var(--fin-desktop-h);
    }
    .hero-actions {
      flex-direction: row;
    }
  }
</style>

<script>
  import { lancerHero } from '@/scripts/hero-scroll'

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach(lancerHero)
</script>
