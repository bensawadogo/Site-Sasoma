---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 * BidonScene.astro — bidon Petrovöll : image instantanée, puis 3D si possible
 * ─────────────────────────────────────────────────────────────────────────────
 *  Pensé pour les smartphones d'entrée de gamme en 3G (Afrique de l'Ouest) :
 *
 *  1. L'image WebP (19-34 Ko) s'affiche TOUT DE SUITE : c'est elle qui sert de
 *     LCP. Elle est rendue depuis la scène 3D elle-même (même cadrage).
 *  2. Après le chargement complet de la page, on choisit un niveau :
 *       • image — économie de données / 2G / ≤ 1 Go de RAM / pas de WebGL :
 *                 rien n'est téléchargé ; un bouton propose la 3D.
 *       • lite  — smartphone ou petit processeur : modèle 161k triangles (1 Mo).
 *       • full  — ordinateur : modèle 269k triangles (1,5 Mo).
 *  3. three.js + le modèle sont chargés en tâche de fond (`import()`), puis la
 *     3D remplace l'image par un fondu, sans saut de mise en page.
 *  Toute erreur (GPU, réseau) laisse simplement l'image en place.
 */
import { IMAGE_BIDON } from '@/lib/image-bidon'

interface Props {
  /** `sizes` de l'image : largeur affichée selon l'écran. */
  sizes?: string
}
const { sizes = '(min-width: 1024px) 620px, (min-width: 640px) 560px, 100vw' } = Astro.props
---

<div class="bidon-scene relative h-full w-full" data-bidon data-etat="image">
  <img
    class="bidon-image absolute inset-0 h-full w-full object-contain"
    src={IMAGE_BIDON.src}
    srcset={IMAGE_BIDON.srcset}
    {sizes}
    width="800"
    height="800"
    alt="Bidon d'huile moteur Petrovöll STÄRK 5W-30"
    fetchpriority="high"
    decoding="async"
  />
  <canvas class="bidon-canvas absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

  <button type="button" class="bidon-bouton" data-bidon-bouton hidden>
    <span aria-hidden="true">⟲</span> Voir en 3D <span class="opacity-70">(≈ 1,3 Mo)</span>
  </button>
  <p class="bidon-aide" aria-hidden="true">Glissez pour faire pivoter</p>
  <p class="bidon-progression" aria-live="polite" data-bidon-progression>Chargement de la 3D…</p>
</div>

<style>
  .bidon-canvas {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
    /* Le glisser horizontal fait tourner, le défilement vertical reste libre. */
    touch-action: pan-y;
    cursor: grab;
  }
  .bidon-canvas:active {
    cursor: grabbing;
  }
  .bidon-image {
    transition: opacity 0.5s ease;
  }
  [data-etat='3d'] .bidon-canvas {
    opacity: 1;
    pointer-events: auto;
  }
  [data-etat='3d'] .bidon-image {
    opacity: 0;
  }

  .bidon-bouton {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    min-height: 44px; /* cible tactile minimale */
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(10 10 10 / 0.75);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }
  [data-etat='chargement'] .bidon-bouton {
    opacity: 0.6;
    pointer-events: none;
  }

  .bidon-aide {
    position: absolute;
    bottom: 0.5rem;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-attenue);
    opacity: 0;
    transition: opacity 0.5s ease 0.5s;
  }
  [data-etat='3d'] .bidon-aide {
    opacity: 1;
  }

  /* Sur une connexion lente, le visiteur voit que la 3D arrive. */
  .bidon-progression {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    font-size: 0.75rem;
    white-space: nowrap;
    display: none;
  }
  [data-etat='chargement'] .bidon-progression {
    display: block;
  }
</style>

<script>
  import type { Qualite } from '@/scripts/bidon-3d'

  type Niveau = 'image' | Qualite
  type NavigatorEtendu = Navigator & {
    connection?: { saveData?: boolean; effectiveType?: string }
    deviceMemory?: number
  }

  /* Test WebGL fait ICI (et plus sur chaque page) : créer un contexte GPU a
     un coût réel sur un téléphone d'entrée de gamme. */
  const webglDisponible = (): boolean => {
    try {
      const gl = document.createElement('canvas').getContext('webgl2')
        ?? document.createElement('canvas').getContext('webgl')
      gl?.getExtension('WEBGL_lose_context')?.loseContext()
      return !!gl
    } catch {
      return false
    }
  }

  const choisirNiveau = (): Niveau => {
    const nav = navigator as NavigatorEtendu
    const connexion = nav.connection
    // L'utilisateur a demandé à économiser ses données : on respecte.
    if (connexion?.saveData) return 'image'
    if (connexion?.effectiveType && /2g$/.test(connexion.effectiveType)) return 'image'
    if ((nav.deviceMemory ?? 4) <= 1) return 'image'
    if (!webglDisponible()) return 'image'

    const petitEcran = window.matchMedia('(max-width: 63.99rem)').matches
    const tactile = window.matchMedia('(pointer: coarse)').matches
    const faible = (nav.hardwareConcurrency ?? 8) <= 4 || (nav.deviceMemory ?? 8) <= 4
    return petitEcran || tactile || faible ? 'lite' : 'full'
  }

  document.querySelectorAll<HTMLElement>('[data-bidon]').forEach((hote) => {
    const bouton = hote.querySelector<HTMLButtonElement>('[data-bidon-bouton]')

    const lancer = async (qualite: Qualite) => {
      hote.dataset.etat = 'chargement'
      try {
        const progression = hote.querySelector<HTMLElement>('[data-bidon-progression]')
        const { monterBidon } = await import('@/scripts/bidon-3d')
        await monterBidon(hote, qualite, (fraction) => {
          if (progression) progression.textContent = `Chargement de la 3D… ${Math.round(fraction * 100)} %`
        })
        hote.dataset.etat = '3d'
        if (bouton) bouton.hidden = true
      } catch (erreur) {
        // L'image reste affichée : le visiteur ne voit jamais d'écran vide.
        console.warn('[bidon-3d] 3D indisponible, image conservée', erreur)
        hote.dataset.etat = 'image'
        if (bouton) bouton.hidden = true
      }
    }

    const demarrer = () => {
      const niveau = choisirNiveau()
      if (niveau === 'image') {
        // Sur demande seulement : le visiteur décide de dépenser ses données.
        if (bouton && webglDisponible()) {
          bouton.hidden = false
          bouton.addEventListener('click', () => lancer('lite'), { once: true })
        }
        return
      }
      lancer(niveau)
    }

    // Dès la fin du chargement de la page (texte, images et boutons passent
    // d'abord) — sans attendre en plus un « temps mort » du navigateur, qui
    // retardait la rotation de plusieurs secondes sur les téléphones lents.
    if (document.readyState === 'complete') demarrer()
    else window.addEventListener('load', demarrer, { once: true })
  })
</script>
